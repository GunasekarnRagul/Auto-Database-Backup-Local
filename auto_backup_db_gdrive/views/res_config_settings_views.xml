<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto.backup</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Back Up Database" string="Back Up Database" name="auto_backup_db_gdrive">
                    <block title="Google Drive Integration" name="gdrive_integration_block">
                        <setting title="Client ID" help="Enter your OAuth 2.0 Client ID from Google Cloud Console.">
                            <field name="gdrive_client_id" placeholder="e.g. 123456...apps.googleusercontent.com"/>
                        </setting>
                        <setting title="Client Secret" help="Enter your OAuth 2.0 Client Secret.">
                            <field name="gdrive_client_secret" password="True" placeholder="••••••••••••••••"/>
                        </setting>
                        <setting title="Target Folder ID" help="Google Drive Folder ID where backups will be stored.">
                            <field name="gdrive_folder_id" placeholder="e.g. 1Ab2Cd3Ef..."/>
                        </setting>

                        <setting string="Authorization &amp; Setup" help="Connect Odoo to your Google Drive account.">
                            <div class="content-group mt-2">
                                <div class="alert alert-info py-2 mb-3 border-0 rounded-3 shadow-sm d-flex align-items-start">
                                    <i class="fa fa-info-circle mt-1 me-3 fs-4 text-info"/>
                                    <div>
                                        <h6 class="alert-heading fw-bold mb-1">How to authorize:</h6>
                                        <ol class="ps-3 mb-0 small">
                                            <li>Go to the <a href="https://console.cloud.google.com/" target="_blank" class="fw-bold text-decoration-underline">Google Cloud Console</a>.</li>
                                            <li>Under <b>APIs &amp; Services &gt; Credentials</b>, update your <b>OAuth 2.0 Client ID</b>.</li>
                                            <li>Add the <b>Redirect URI</b> below to the <i>Authorized redirect URIs</i> section.</li>
                                        </ol>
                                    </div>
                                </div>

                                <div class="p-3 border rounded-3 bg-light mb-4 shadow-sm">
                                    <label for="gdrive_redirect_uri" class="d-block small text-muted text-uppercase fw-bold mb-1">Redirect URI</label>
                                    <div class="d-flex align-items-center">
                                        <field name="gdrive_redirect_uri" widget="copy_clipboard" readonly="1" class="fw-bold text-primary flex-grow-1"/>
                                        <span class="ms-2 text-muted" title="This URI is automatically formed based on your current browser URL and should be added to your Google Cloud Console.">
                                            <i class="fa fa-question-circle cursor-pointer"/>
                                        </span>
                                    </div>
                                </div>

                                <!-- Action Buttons & Status -->
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <button name="action_gdrive_authenticate" 
                                            type="object" 
                                            string="Connect Google Account" 
                                            class="btn btn-primary" 
                                            invisible="gdrive_refresh_token or not gdrive_client_id or not gdrive_client_secret or not gdrive_folder_id">
                                        <i class="fa fa-google me-2"/> Connect
                                    </button>
                                    
                                    <div class="d-flex align-items-center gap-2" invisible="not gdrive_refresh_token">
                                        <div class="alert alert-success d-flex align-items-center py-2 px-3 m-0 border-0 rounded-3 shadow-sm">
                                            <i class="fa fa-check-circle me-2 fs-5"/>
                                            <span class="small fw-bold">Authorized Successfully</span>
                                        </div>
                                        <button name="action_gdrive_authenticate" 
        type="object" 
        class="btn btn-outline-secondary btn-sm d-inline-flex flex-column align-items-center"
        invisible="not gdrive_client_id or not gdrive_client_secret or not gdrive_folder_id">
    <i class="fa fa-refresh mb-1"/> 
    <span>Re-connect</span>
</button>

<button name="action_gdrive_disconnect" 
        type="object" 
        class="btn btn-outline-danger btn-sm d-inline-flex flex-column align-items-center"
        confirm="Are you sure you want to disconnect Google Drive and reset all credentials?"
        invisible="not gdrive_refresh_token">
    <i class="fa fa-power-off mb-1"/>
    <span>Disconnect </span>
</button>
                                    </div>
                                </div>
                                <field name="gdrive_refresh_token" invisible="1"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Auto Backup Settings" name="gdrive_backup_config_block" invisible="not gdrive_refresh_token">
                        <setting title="Enable Auto Backup" help="Automatically backup the database to Google Drive at specified intervals.">
                            <field name="gdrive_backup_active"/>
                        </setting>
                        <setting title="Backup Frequency" help="Set how often the database should be backed up." invisible="not gdrive_backup_active">
                            <div class="content-group">
                                <div class="mt16">
                                    <span>Every </span>
                                    <field name="gdrive_backup_interval_number" class="oe_inline"/>
                                    <field name="gdrive_backup_interval_type" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting title="Sync Rules" help="Define which databases should be backed up.">
                            <div class="content-group">
                                <field name="gdrive_sync_scope" widget="radio" class="w-50 mb-3"/>
                                <div invisible="gdrive_sync_scope != 'selective'" class="mt-2 mb-3">
                                    <label for="gdrive_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                    <field name="gdrive_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                    <div class="small text-muted mt-1">
                                        <i class="fa fa-info-circle me-1"/> 
                                        Select the databases to include in the backup.
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting title="Last Backup" help="Date and time of the last successful backup." invisible="not gdrive_backup_last_run">
                            <field name="gdrive_backup_last_run" widget="date"/>
                        </setting>

                    </block>
                    <block title="Manual Backup Settings" name="gdrive_manual_backup_block" invisible="not gdrive_refresh_token">
                        <setting title="Sync Rules" help="Define which databases to include in the manual backup.">
                            <div class="content-group">
                                <field name="gdrive_manual_sync_scope" widget="radio" class="w-50 mb-3"/>
                                <div invisible="gdrive_manual_sync_scope != 'selective'" class="mt-2 mb-3">
                                    <label for="gdrive_manual_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                    <field name="gdrive_manual_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                    <div class="small text-muted mt-1">
                                        <i class="fa fa-info-circle me-1"/> 
                                        Select the databases to include in the manual backup.
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting title="Manual Sync" help="Trigger a manual backup to Google Drive immediately using the settings above.">
                            <div class="content-group">
                                <div class="mt-2">
                                    <button name="action_manual_sync" 
                                            type="object" 
                                            string="Manual BackUp" 
                                            class="btn btn-primary"
                                            confirm="Are you sure you want to start the manual backup? This may take some time depending on the database size."/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Retention Policy" name="gdrive_retention_policy_block" invisible="not gdrive_refresh_token">
                        <div class="text-muted small mb-3">
                            Configure how long to keep your backups in Google Drive to save storage space.
                        </div>
                        <div class="row">
                            <setting class="col-12 col-lg-6" title="Retention Type" help="Choose how you want to prune old backups.">
                                <field name="gdrive_retention_type" widget="radio"/>
                            </setting>
                            <setting class="col-12 col-lg-6" title="Retention Limit" invisible="gdrive_retention_type == 'none'">
                                <div invisible="gdrive_retention_type != 'count'">
                                    <div class="d-flex align-items-center">
                                        <span>Keep last </span>
                                        <field name="gdrive_retention_count" class="mx-2 oe_inline fw-bold"/>
                                        <span> backups</span>
                                    </div>
                                </div>
                                <div invisible="gdrive_retention_type != 'days'">
                                    <div class="d-flex align-items-center">
                                        <span>Keep for </span>
                                        <field name="gdrive_retention_days" class="mx-2 oe_inline fw-bold"/>
                                        <span> days</span>
                                    </div>
                                </div>
                            </setting>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
