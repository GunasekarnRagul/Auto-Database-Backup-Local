<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.s3.backup</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Back Up Database" string="Back Up Database" name="auto_backup_db_aws_s3">
                    <block title="AWS S3 Integration" name="s3_integration_block">
                        <field name="s3_is_connection_tested" invisible="1"/>
                        <setting title="Access Key ID" help="Enter your AWS Access Key ID.">
                            <field name="s3_access_key" placeholder="e.g. AKIA..."/>
                        </setting>
                        <setting title="Secret Access Key" help="Enter your AWS Secret Access Key.">
                            <field name="s3_secret_key" password="True" placeholder="••••••••••••••••"/>
                        </setting>
                        <setting title="Bucket Name" help="AWS S3 Bucket where backups will be stored.">
                            <field name="s3_bucket" placeholder="e.g. my-odoo-backups"/>
                        </setting>
                        <setting title="Region" help="AWS Region where your bucket is located.">
                            <field name="s3_region" placeholder="e.g. us-east-1"/>
                        </setting>
                        <setting title="Connection Management">
                            <div class="mt-2">
                                <button name="action_test_s3_connection" 
                                        type="object" 
                                        string="Test Connection" 
                                        class="btn btn-primary me-2"
                                        invisible="s3_is_connection_tested"/>
                                
                                <button name="action_reset_s3_connection" 
                                        type="object" 
                                        string="Reset Connection" 
                                        class="btn btn-secondary me-2"
                                        invisible="not s3_is_connection_tested"/>
                                
                                <button name="action_disconnect_s3" 
                                        type="object" 
                                        string="Disconnect" 
                                        class="btn btn-danger"
                                        confirm="Are you sure you want to disconnect and clear S3 credentials?"
                                        invisible="not s3_is_connection_tested"/>
                            </div>
                            <div invisible="not s3_is_connection_tested" class="mt-3">
                                <span class="badge text-bg-success fs-6 p-2">
                                    <i class="fa fa-check-circle me-1"/>Connected to AWS S3
                                </span>
                            </div>
                        </setting>
                    </block>

                    <div invisible="not s3_is_connection_tested" class="mt-4">
                        <notebook>
                            <page string="1. Auto Backup Settings" name="s3_backup_config_page">
                                <block title="Auto Backup Configuration">
                                    <setting title="Enable Auto Backup" help="Automatically backup the database to AWS S3 at specified intervals.">
                                        <field name="s3_backup_active"/>
                                    </setting>
                                    <setting title="Backup Frequency" help="Set how often the database should be backed up." invisible="not s3_backup_active">
                                        <div class="content-group">
                                            <div class="mt16">
                                                <span>Every </span>
                                                <field name="s3_backup_interval_number" class="oe_inline"/>
                                                <field name="s3_backup_interval_type" class="oe_inline" style="margin-left:10px"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Sync Rules" help="Define which databases should be backed up.">
                                        <div class="content-group">
                                            <field name="s3_sync_scope" widget="radio" class="w-50 mb-3"/>
                                            <div invisible="s3_sync_scope != 'selective'" class="mt-2 mb-3">
                                                <label for="s3_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                                <field name="s3_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Last Backup" help="Date and time of the last successful backup." invisible="not s3_backup_last_run">
                                        <field name="s3_backup_last_run" widget="date"/>
                                    </setting>
                                </block>
                            </page>
                            
                            <page string="2. Manual Backup Settings" name="s3_manual_backup_page">
                                <block title="Manual Backup Configuration">
                                    <setting title="Sync Rules" help="Define which databases to include in the manual backup.">
                                        <div class="content-group">
                                            <field name="s3_manual_sync_scope" widget="radio" class="w-50 mb-3"/>
                                            <div invisible="s3_manual_sync_scope != 'selective'" class="mt-2 mb-3">
                                                <label for="s3_manual_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                                <field name="s3_manual_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Manual Sync" help="Trigger a manual backup to AWS S3 immediately using the settings above.">
                                        <div class="content-group">
                                            <div class="mt-2">
                                                <button name="action_manual_sync" 
                                                        type="object" 
                                                        string="Manual BackUp" 
                                                        class="btn btn-primary"
                                                        confirm="Start manual backup to AWS S3? (Note: This may take a while depending on DB size.)"/>
                                            </div>
                                        </div>
                                    </setting>
                                </block>
                            </page>
                            
                            <page string="3. Retention Policy" name="s3_retention_policy_page">
                                <block title="Retention Policy Configuration">
                                    <div class="text-muted small mb-3">
                                        Configure how long to keep your backups in AWS S3 to save storage costs.
                                    </div>
                                    <div class="row">
                                        <setting class="col-12 col-lg-6" title="Retention Type" help="Choose how you want to prune old backups.">
                                            <field name="s3_retention_type" widget="radio"/>
                                        </setting>
                                        <setting class="col-12 col-lg-6" title="Retention Limit" invisible="s3_retention_type == 'none'">
                                            <div invisible="s3_retention_type != 'count'">
                                                <div class="d-flex align-items-center">
                                                    <span>Keep last </span>
                                                    <field name="s3_retention_count" class="mx-2 oe_inline fw-bold"/>
                                                    <span> backups</span>
                                                </div>
                                            </div>
                                            <div invisible="s3_retention_type != 'days'">
                                                <div class="d-flex align-items-center">
                                                    <span>Keep for </span>
                                                    <field name="s3_retention_days" class="mx-2 oe_inline fw-bold"/>
                                                    <span> days</span>
                                                </div>
                                            </div>
                                        </setting>
                                    </div>
                                </block>
                            </page>
                        </notebook>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
