<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_aws_s3" model="ir.ui.view">
        <field name="name">res.config.settings.view.aws.s3</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AWS S3 Integration" string="AWS S3 Integration" name="aws_odoo_integration_cloudaddons">
                    <block title="AWS S3 Integration" name="s3_integration_block">
                        <field name="aws_is_connection_tested" invisible="1"/>
                        <setting title="Access Key ID" help="Enter your AWS Access Key ID.">
                            <field name="aws_access_key_id" placeholder="e.g. AKIA..."/>
                        </setting>
                        <setting title="Secret Access Key" help="Enter your AWS Secret Access Key.">
                            <field name="aws_secret_access_key" password="True" placeholder="••••••••••••••••"/>
                        </setting>
                        <setting title="Bucket Name" help="AWS S3 Bucket where backups will be stored.">
                            <field name="aws_s3_bucket_name" placeholder="e.g. my-odoo-backups"/>
                        </setting>
                        <setting title="Region" help="AWS Region where your bucket is located.">
                            <field name="aws_region" placeholder="e.g. us-east-1"/>
                        </setting>
                        <setting title="Connection Management">
                            <div class="mt-2">
                                <button name="action_test_aws_s3_connection" 
                                        type="object" 
                                        string="Test Connection" 
                                        class="btn btn-primary me-2"
                                        invisible="aws_is_connection_tested"/>
                                
                                <button name="action_reset_aws_s3_connection" 
                                        type="object" 
                                        string="Reset Connection" 
                                        class="btn btn-secondary me-2"
                                        invisible="not aws_is_connection_tested"/>
                                
                                <button name="action_disconnect_aws_s3" 
                                        type="object" 
                                        string="Disconnect" 
                                        class="btn btn-danger"
                                        confirm="Are you sure you want to disconnect and clear S3 credentials?"
                                        invisible="not aws_is_connection_tested"/>
                            </div>
                            <div invisible="not aws_is_connection_tested" class="mt-3">
                                <span class="badge text-bg-success fs-6 p-2">
                                    <i class="fa fa-check-circle me-1"/>Connected to AWS S3
                                </span>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
