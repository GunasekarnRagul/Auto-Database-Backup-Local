<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nextcloud</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Nextcloud Backup" string="Nextcloud Backup" name="auto_backup_db_nextcloud">
                    <block title="Nextcloud Integration" name="nextcloud_integration_block">
                        <field name="nextcloud_is_authorized" invisible="1"/>
                        <setting title="Server URL" help="Enter your Nextcloud Server URL (e.g. https://cloud.example.com).">
                            <field name="nextcloud_url" placeholder="https://nextcloud.yourdomain.com"/>
                        </setting>
                        <setting title="Username" help="Enter your Nextcloud Username.">
                            <field name="nextcloud_username" placeholder="Username"/>
                        </setting>
                        <setting title="App Password" help="Enter your Nextcloud App Password.">
                            <field name="nextcloud_password" password="True" placeholder="••••••••••••••••"/>
                        </setting>
                          <setting title="Folder Path" help="Nextcloud folder where backups will be stored (e.g. /Odoo_Backups).">
                            <field name="nextcloud_folder_path" placeholder="/Odoo_Backups"/>
                        </setting>
                        
                        <setting string="Authorization &amp; Setup" help="Connect Odoo to your Nextcloud account via WebDAV.">
                            <div class="content-group mt-2">
                                <div class="alert alert-info py-2 mb-3 border-0 rounded-3 shadow-sm d-flex align-items-start">
                                    <i class="fa fa-info-circle mt-1 me-3 fs-4 text-info"/>
                                    <div>
                                        <h6 class="alert-heading fw-bold mb-1">How to authorize:</h6>
                                        <ol class="ps-3 mb-0 small">
                                            <li>Go to your Nextcloud instance.</li>
                                            <li>Navigate to <b>Settings &gt; Personal &gt; Security</b>.</li>
                                            <li>Scroll down to <b>Devices &amp; sessions</b>.</li>
                                            <li>Enter an app name (e.g., "Odoo Backup") and click <b>Create new app password</b>.</li>
                                            <li>Copy the generated <b>App Password</b> and paste it above.</li>
                                        </ol>
                                    </div>
                                </div>

                                <!-- Action Buttons & Status -->
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <button name="action_nextcloud_authenticate" 
                                            type="object" 
                                            string="Connect Nextcloud" 
                                            class="btn btn-primary" 
                                            invisible="nextcloud_is_authorized or not nextcloud_url or not nextcloud_username or not nextcloud_password">
                                        <i class="fa fa-cloud me-2"/> Connect
                                    </button>
                                    
                                    <div class="d-flex align-items-center gap-2" invisible="not nextcloud_is_authorized">
                                        <div class="alert alert-success d-flex align-items-center py-2 px-3 m-0 border-0 rounded-3 shadow-sm">
                                            <i class="fa fa-check-circle me-2 fs-5"/>
                                            <span class="small fw-bold">Authorized Successfully</span>
                                        </div>

                                        <button name="action_nextcloud_disconnect" 
                                                type="object" 
                                                class="btn btn-outline-danger btn-sm d-inline-flex flex-column align-items-center"
                                                confirm="Are you sure you want to disconnect Nextcloud and reset all credentials?"
                                                invisible="not nextcloud_is_authorized">
                                            <i class="fa fa-power-off mb-1"/>
                                            <span>Disconnect</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </setting>
                      
                    </block>

                    <div invisible="not nextcloud_is_authorized" class="mt-4">
                        <notebook>
                            <page string="1. Auto Backup Settings" name="nextcloud_auto_backup_page">
                                <block title="Auto Backup Configuration">
                                    <setting title="Enable Auto Backup" help="Automatically backup the database to Nextcloud at specified intervals.">
                                        <field name="nextcloud_backup_active"/>
                                    </setting>
                                    <setting title="Backup Frequency" help="Set how often the database should be backed up." invisible="not nextcloud_backup_active">
                                        <div class="content-group">
                                            <div class="mt16">
                                                <span>Every </span>
                                                <field name="nextcloud_backup_interval_number" class="oe_inline"/>
                                                <field name="nextcloud_backup_interval_type" class="oe_inline" style="margin-left:10px"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Sync Rules" help="Define which databases should be backed up automatically.">
                                        <div class="content-group">
                                            <field name="nextcloud_sync_scope" widget="radio" class="w-50 mb-3"/>
                                            <div invisible="nextcloud_sync_scope != 'selective'" class="mt-2 mb-3">
                                                <label for="nextcloud_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                                <field name="nextcloud_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Last Backup" help="Date and time of the last successful backup." invisible="not nextcloud_backup_last_run">
                                        <field name="nextcloud_backup_last_run" widget="date"/>
                                    </setting>
                                </block>
                            </page>
                            
                            <page string="2. Manual Backup Settings" name="nextcloud_manual_backup_page">
                                <block title="Manual Backup Configuration">
                                    <setting title="Sync Rules" help="Define which databases to include in the manual backup.">
                                        <div class="content-group">
                                            <field name="nextcloud_manual_sync_scope" widget="radio" class="w-50 mb-3"/>
                                            <div invisible="nextcloud_manual_sync_scope != 'selective'" class="mt-2 mb-3">
                                                <label for="nextcloud_manual_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                                <field name="nextcloud_manual_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                            </div>
                                        </div>
                                    </setting>
                                    <setting title="Manual Sync" help="Trigger a manual backup to Nextcloud immediately.">
                                        <div class="content-group">
                                            <div class="mt-2">
                                                <button name="action_manual_sync" 
                                                        type="object" 
                                                        string="Manual BackUp" 
                                                        class="btn btn-primary"
                                                        confirm="Start manual backup to Nextcloud? (Note: This may take a while depending on DB size.)"/>
                                            </div>
                                        </div>
                                    </setting>
                                </block>
                            </page>
                            
                            <page string="3. Retention Policy" name="nextcloud_retention_policy_page">
                                <block title="Retention Policy Configuration">
                                    <div class="text-muted small mb-3">
                                        Configure how long to keep your backups in Nextcloud to save storage space.
                                    </div>
                                    <div class="row">
                                        <setting class="col-12 col-lg-6" title="Retention Type" help="Choose how you want to prune old backups.">
                                            <field name="nextcloud_retention_type" widget="radio"/>
                                        </setting>
                                        <setting class="col-12 col-lg-6" title="Retention Limit" invisible="nextcloud_retention_type == 'none'">
                                            <div invisible="nextcloud_retention_type != 'count'">
                                                <div class="d-flex align-items-center">
                                                    <span>Keep last </span>
                                                    <field name="nextcloud_retention_count" class="mx-2 oe_inline fw-bold"/>
                                                    <span> backups</span>
                                                </div>
                                            </div>
                                            <div invisible="nextcloud_retention_type != 'days'">
                                                <div class="d-flex align-items-center">
                                                    <span>Keep for </span>
                                                    <field name="nextcloud_retention_days" class="mx-2 oe_inline fw-bold"/>
                                                    <span> days</span>
                                                </div>
                                            </div>
                                        </setting>
                                    </div>
                                </block>
                            </page>
                        </notebook>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_nextcloud_backup_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'auto_backup_db_nextcloud'}</field>
    </record>
</odoo>
