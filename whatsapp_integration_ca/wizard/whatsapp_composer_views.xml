<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_composer_form" model="ir.ui.view">
        <field name="name">whatsapp.composer.form</field>
        <field name="model">whatsapp.composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <sheet>
                    <group>
                        <field name="recipient_single" required="1" placeholder="+1234567890"/>
                        <field name="message_type" invisible="1"/>
                    </group>
                    
                    <field name="message_body" 
                           widget="text" 
                           placeholder="Type your message here..."
                           style="min-height: 150px;"/>
                </sheet>
                <footer>
                    <button name="action_send_message" string="Send Message" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_composer" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Information</field>
        <field name="res_model">whatsapp.composer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
