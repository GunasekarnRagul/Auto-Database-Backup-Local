<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_whatsapp_message_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list string="Message History" 
                  decoration-success="state == 'sent'"
                  decoration-warning="state == 'partial'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'scheduled'"
                  decoration-primary="state == 'queued'">
                <field name="create_date"/>
                <field name="recipient_type"/>
                <field name="mobile_number_display" string="Mobile Number"/>
                <field name="message_body"/>
                <field name="detailed_status" widget="badge"
                       decoration-info="state == 'scheduled'"
                       decoration-primary="state == 'queued'"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'failed'"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View - Professional Design -->
    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Compose Message">
                <header>
                    <button name="action_send_message"
                            string="Send Now"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="state in ('sent', 'queued', 'scheduled') or (recipient_type != 'single' and state != 'draft')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,queued,sent,failed"/>
                </header>

                <sheet>
                    <field name="log_success" invisible="1"/>
                    <field name="log_failure" invisible="1"/>

                    <!-- Ribbons -->
                    <widget name="web_ribbon" title="Sent" bg_color="bg-success" invisible="state != 'sent'"/>
                    <widget name="web_ribbon" title="Scheduled" bg_color="bg-info" invisible="state != 'scheduled'"/>
                    <widget name="web_ribbon" title="Processing" bg_color="bg-primary" invisible="state != 'queued'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="bg-danger" invisible="state != 'failed'"/>

                    <!-- DRAFT / EDIT MODE: Compose Form -->
                    <div invisible="state in ('sent', 'queued', 'scheduled') or (state != 'draft' and recipient_type != 'single')">
                        
                        <div class="alert alert-warning mb-3" invisible="state == 'draft' or recipient_type != 'single'">
                            <h5 class="mb-1"><i class="fa fa-edit"/> Edit &amp; Resend Message</h5>
                            <small class="text-muted">You can update the recipients, message, or schedule and click <b>Send Now</b> again.</small>
                        </div>

                        <!-- Hero Header -->
                        <div class="mb-4" invisible="state != 'draft'">
                            <div class="p-4 rounded shadow-sm border-0" 
                                 style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); color: white;">
                                <div class="row align-items-center">
                                    <div class="col-8">
                                        <h2 class="m-0 fw-bold text-white">
                                            <i class="fa fa-paper-plane-o me-2"/> Craft Your Message
                                        </h2>
                                        <p class="m-0 mt-1 opacity-75" style="font-size: 14px;">
                                            Compose and send professional WhatsApp messages to your customers instantly.
                                        </p>
                                    </div>
                                    <div class="col-4 text-end">
                                        <i class="fa fa-whatsapp opacity-25" style="font-size: 60px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group string="📱 Recipients" name="recipients">
                                <field name="recipient_type" widget="radio" options="{'horizontal': true}"/>

                                <field name="recipient_single"
                                       placeholder="+91 98765 43210"
                                       invisible="recipient_type != 'single'"
                                       required="recipient_type == 'single'"
                                       class="o_field_highlight"/>
                                
                                <field name="recipient_contacts"
                                       widget="many2many_tags"
                                       placeholder="Select Contacts"
                                       invisible="recipient_type != 'contact'"
                                       required="recipient_type == 'contact'"/>

                                <label for="recipient_multi" invisible="recipient_type != 'multi'"/>
                                <div invisible="recipient_type != 'multi'">
                                    <field name="recipient_multi"
                                           placeholder="+919876543210, +919876543211 (Comma separated)"
                                           style="min-height: 100px;"/>

                                    <div class="mt-2 d-flex align-items-center gap-2">
                                        <button name="%(action_whatsapp_import_wizard)d"
                                                type="action"
                                                string=" Import from Excel"
                                                class="btn btn-outline-success btn-sm"
                                                icon="fa-file-excel-o"/>
                                        <span class="text-muted small">Supports .xlsx, .xls, .csv</span>
                                    </div>
                                </div>
                            </group>

                            <group string="⏰ Schedule (Optional)" name="schedule">
                                <field name="schedule_datetime" placeholder='YYYY-MM-DD HH:MM'/>
                                <field name="timezone" invisible="not schedule_datetime"/>
                                <field name="schedule_display" invisible="not schedule_datetime"/>
                            </group>
                        </group>

                      
                        
                        <separator string="💬 Message Content"/>
                        
                        <!-- Message Type Selector -->
                        <div class="mb-3">
                            <field name="message_type" widget="radio" options="{'horizontal': true}"/>
                        </div>
                        
                        <!-- ==================== 1. TEXT MESSAGE ==================== -->
                        <div invisible="message_type != 'text'">
                            <field name="message_body"
                                   widget="text"
                                   placeholder="Type your WhatsApp message here..."
                                   nolabel="1"
                                   style="min-height: 180px; font-size: 15px; padding: 15px; border: 2px solid #25D366; border-radius: 8px; background: #f8fff8;"/>
                        </div>
                        
                        
                        <!-- ==================== 3. MEDIA MESSAGE ==================== -->
                        <div invisible="message_type != 'media'">
                            <group>
                                <field name="media_type" widget="radio" options="{'horizontal': true}"/>
                                
                                <field name="media_file" filename="media_filename" widget="binary" string="Upload File" required="message_type == 'media'"/>
                                <field name="media_filename" invisible="1"/>
                                       
                                <field name="media_caption" placeholder="Add a caption..."
                                       invisible="media_type == 'audio'"/>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="media_type != 'image'">
                                <i class="fa fa-image"/> <strong>Image Rules:</strong> Size &lt; 5MB. Formats: .jpg, .jpeg, .png
                            </div>
                            <div class="alert alert-info" role="alert" invisible="media_type != 'document'">
                                <i class="fa fa-file-text"/> <strong>Document Rules:</strong> Size &lt; 100MB. Formats: .pdf, .docx, .xlsx, .txt, .csv etc.
                            </div>
                        </div>

                        <!-- ==================== 4. LOCATION MESSAGE REMOVED ==================== -->
                        
                        <!-- ==================== 5. INTERACTIVE MESSAGE REMOVED ==================== -->
                        
                        <!-- ==================== 6. TIPS SECTION ==================== -->
                        <div class="alert alert-info mt-3" role="alert" invisible="state != 'draft'">
                            <i class="fa fa-info-circle"/> <strong>Tips:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Numbers must include country code (e.g., +91 for India)</li>
                                <li>Schedule messages for later by setting date/time above</li>
                            </ul>
                        </div>

                    </div>

                    <!-- DASHBOARD VIEW: Visible in all states except Draft -->
                    <div invisible="state == 'draft'">

                        <div class="card shadow-lg border-0 mt-3" style="border-radius: 15px; overflow: hidden;">

                            <!-- Header: Processing -->
                            <div class="card-header p-4" 
                                 style="background: RGBA(113, 99, 158, 1); color: white;"
                                 invisible="state != 'queued'">
                                <h3 style="color: white;" class="m-0">
                                    <i class="fa fa-refresh fa-spin"/>
                                    <span class="ms-2">Message Processing</span>
                                </h3>
                                <small>Your message is being sent in the background...</small>
                            </div>

                            <!-- Header: Scheduled -->
                            <div class="card-header p-4" 
                                 style="background: #0180a5; color: white;"
                                 invisible="state != 'scheduled'">
                                <h3 style="color: white;" class="m-0">
                                    <i class="fa fa-clock-o"/>
                                    <span class="ms-2">Message Scheduled</span>
                                </h3>
                                <small>Your message will be sent at the scheduled time.</small>
                            </div>

                            <!-- Header -->
                            <div class="card-header p-4" 
                                 style="background: linear-gradient(135deg, #25D366, #128C7E);t color: white;"
                                 invisible="state != 'sent'">
                                <h3 style="color: white;" class="m-0">
                                    <i class="fa fa-check-circle"/> Message Delivered Successfully
                                </h3>
                                <small>All recipients received the message</small>
                            </div>

                            <div class="card-header p-4" 
                                 style="background: linear-gradient(135deg, #ffc107, #e0a800); color: white;"
                                 invisible="state != 'partial'">
                                <h3 style="color: white;" class="m-0">
                                    <i class="fa fa-exclamation-circle"/> Partial Delivery
                                </h3>
                                <small>Some messages failed to deliver</small>
                            </div>

                            <div class="card-header p-4" 
                                 style="background: linear-gradient(135deg, #dc3545, #c82333); color: white;"
                                 invisible="state != 'failed'">
                                <h3 style="color: white;" class="m-0">
                                    <i class="fa fa-times-circle"/> Delivery Failed
                                </h3>
                                <small>Message could not be delivered</small>
                            </div>

                            <!-- Body -->
                            <div class="card-body p-4 bg-white">

                                <div class="row g-4">
                                    <!-- Left Column - Stats -->
                                    <div class="col-md-6 border-end">
                                        <h5 class="text-primary mb-4">
                                            <i class="fa fa-bar-chart"/> Delivery Statistics
                                        </h5>

                                        <!-- Stats List -->
                                        <div class="d-flex flex-column gap-3">
                                            
                                            <!-- Recipients -->
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; border: 1px solid #e0e0e0;">
                                                    <i class="fa fa-users" style="color: #0056b3;"/>
                                                </div>
                                                <div>
                                                    <small class="text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px; color: #0056b3;">Recipients</small>
                                                    <div class="fw-bold text-dark"><field name="mobile_number_display" readonly="1"/></div>
                                                </div>
                                            </div>

                                            <!-- Status -->
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; border: 1px solid #e0e0e0;">
                                                    <i class="fa fa-info-circle" style="color: #0056b3;"/>
                                                </div>
                                                <div>
                                                    <small class="text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px; color: #0056b3;">Delivery Status</small>
                                                    <div>
                                                        <field name="detailed_status" readonly="1" 
                                                               decoration-info="state == 'scheduled'"
                                                               decoration-primary="state == 'queued'"
                                                               decoration-success="state == 'sent'"
                                                               decoration-warning="state == 'partial'"
                                                               decoration-danger="state == 'failed'"
                                                               widget="badge"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Created On -->
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; border: 1px solid #e0e0e0;">
                                                    <i class="fa fa-calendar-check-o" style="color: #0056b3;"/>
                                                </div>
                                                <div>
                                                    <small class="text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px; color: #0056b3;">Created On</small>
                                                    <div class="text-dark" style="font-size: 14px; font-weight: 500;">
                                                        <field name="formatted_create_date" readonly="1"/>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <!-- Right Column - Message Preview -->
                                    <div class="col-md-6">
                                        <h5 class="text-primary mb-4">
                                            <i class="fa fa-commenting"/> Message Preview
                                        </h5>

                                        <!-- WhatsApp Preview Container -->
                                        <div style="background: #ECE5DD; border-radius: 8px; overflow: hidden; border: 1px solid #d1d1d1;">
                                            
                                            <!-- Chat Area with WhatsApp pattern -->
                                            <div style="background-color: #ECE5DD; background-image: url('data:image/svg+xml,%3Csvg width=&quot;200&quot; height=&quot;200&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cdefs%3E%3Cpattern id=&quot;p&quot; width=&quot;60&quot; height=&quot;60&quot; patternUnits=&quot;userSpaceOnUse&quot;%3E%3Ccircle cx=&quot;10&quot; cy=&quot;10&quot; r=&quot;2&quot; fill=&quot;%23d4cdc5&quot;/%3E%3Ccircle cx=&quot;40&quot; cy=&quot;30&quot; r=&quot;2&quot; fill=&quot;%23d4cdc5&quot;/%3E%3Ccircle cx=&quot;25&quot; cy=&quot;50&quot; r=&quot;1.5&quot; fill=&quot;%23d4cdc5&quot;/%3E%3C/pattern%3E%3C/defs%3E%3Crect width=&quot;200&quot; height=&quot;200&quot; fill=&quot;url(%23p)&quot;/%3E%3C/svg%3E'); padding: 24px 16px; ">
                                                
                                                <!-- Message Bubble with Tail -->
                                                <div style="position: relative; margin-left: 8px;">
                                                    <!-- Light Theme Tail -->
                                                    <div style="position: absolute; left: -8px; top: 0; width: 8px; height: 13px; background: white; clip-path: polygon(100% 0, 0 0, 100% 100%);"/>
                                                    
                                                    <div style="background: white; padding: 6px; border-radius: 7.5px; border-top-left-radius: 0; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); margin-bottom: 8px; color: #111b21;">
                                                        
                                                        <div style="font-size: 14.2px; line-height: 1.4; margin-bottom: 2px; white-space: pre-wrap;">
                                                            <field name="show_full_message" invisible="1"/>
                                                            <field name="is_long_message" invisible="1"/>

                                                            <!-- 1. COLLAPSED PREVIEW (Truncated) -->
                                                            <div invisible="show_full_message or not is_long_message">
                                                                <!-- Document logic in collapsed state -->
                                                                <div invisible="message_type != 'media' or media_type != 'document'" 
                                                                     style="background: rgba(255,255,255,0.4); border-radius: 6px; padding: 8px 10px; display: flex; align-items: center; gap: 12px; margin-bottom: 4px; border: 1px solid rgba(0,0,0,0.05);">
                                                                    <div style="width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #54656f;">
                                                                        <i class="fa fa-file fa-2x"/>
                                                                    </div>
                                                                    <div style="flex-grow: 1; overflow: hidden; min-width: 0;">
                                                                        <div class="text-truncate" style="font-size: 13.5px; font-weight: 600; margin-bottom: 1px; color: #111b21; letter-spacing: -0.01em;">
                                                                            <field name="media_filename" readonly="1" nolabel="1"/>
                                                                        </div>
                                                                        <div style="font-size: 10.5px; color: #667781; opacity: 0.85; letter-spacing: 0.02em;">
                                                                            <field name="file_size_display" readonly="1" nolabel="1"/>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Image logic in collapsed state -->
                                                                <div invisible="message_type != 'media' or media_type != 'image'" 
                                                                     style="overflow: hidden; border-radius: 6px; margin-bottom: 4px; border: 1px solid rgba(0,0,0,0.05); background: #fff;">
                                                                    <field name="media_file" widget="image" class="w-100 d-block" 
                                                                           style="max-height: 150px; object-fit: contain;" readonly="1"/>
                                                                </div>

                                                                <!-- Text content in collapsed state -->
                                                                <div class="px-2 pt-1 pb-1" style="white-space: pre-wrap; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14.1px; line-height: 1.5; letter-spacing: 0.01em;">
                                                                    <div invisible="message_type == 'media'">
                                                                        <field name="message_body_truncated" readonly="1" nolabel="1"/>
                                                                    </div>
                                                                    <div invisible="message_type != 'media' or not media_caption">
                                                                        <field name="media_caption_truncated" readonly="1" nolabel="1"/>
                                                                    </div>
                                                                </div>
                                                                
                                                                <div style="display: flex; justify-content: flex-end; margin-top: -2px;">
                                                                    <button name="action_toggle_full_message" type="object" 
                                                                            string="...Read more" class="btn-link p-0 mb-1 px-2" 
                                                                            style="font-size: 12.5px; color: #027eb5; text-decoration: none; font-weight: 600; background: transparent; border: none; opacity: 0.9;"/>
                                                                </div>
                                                            </div>

                                                            <!-- 2. EXPANDED PREVIEW (Full Version) -->
                                                            <div invisible="not show_full_message and is_long_message">
                                                                
                                                                <!-- 1. Document Preview (Light Mode) -->
                                                                <div invisible="message_type != 'media' or media_type != 'document'" 
                                                                     style="background: rgba(255,255,255,0.4); border-radius: 6px; padding: 8px 10px; display: flex; align-items: center; gap: 12px; margin-bottom: 4px; border: 1px solid rgba(0,0,0,0.05);">
                                                                    
                                    <field name="document_icon_color" invisible="1"/>
                                    <field name="document_icon_class" invisible="1"/>
                                    <field name="document_short_label" invisible="1"/>

                                    <!-- PIXEL-PERFECT CUSTOM ICON BOXES -->
                                    <div style="width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #e91212ff;"
                                         invisible="document_short_label != 'PDF'">
                                        PDF
                                    </div>
                                    
                                    <div style="width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #1d6f42;"
                                         invisible="document_short_label != 'X'">
                                        XLS
                                    </div>
                                    
                                    <div style="width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #2b579a;"
                                         invisible="document_short_label != 'W'">
                                        WORD
                                    </div>
                                    
                                    <div style="text-align: center; width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #00a3da;"
                                         invisible="document_short_label not in ('TXT', 'CSV')">
                                        <field name="document_short_label" nolabel="1"/>
                                    </div>

                                    <div style="width: 42px; height: 42px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; font-weight: bold; font-size: 11.5px; letter-spacing: 0.5px; background-color: #54656f;"
                                         invisible="document_short_label in ('PDF', 'X', 'W', 'TXT', 'CSV') and document_short_label != ''">
                                        <i class="fa fa-file fa-2x"/>
                                    </div>

                                                                    <div style="flex-grow: 1; overflow: hidden; min-width: 0;">
                                                                        <div class="text-truncate" style="font-size: 13.5px; font-weight: 600; margin-bottom: 1px; color: #111b21; letter-spacing: -0.01em;">
                                                                            <field name="media_filename" readonly="1" nolabel="1"/>
                                                                        </div>
                                                                        <div style="font-size: 10.5px; color: #667781; opacity: 0.85; letter-spacing: 0.02em;">
                                                                            <field name="document_ext_label" readonly="1" nolabel="1"/>
                                                                            <span class="mx-1">•</span>
                                                                            <field name="file_size_display" readonly="1" nolabel="1"/>
                                                                        </div>
                                                                    </div>

                                                                    <div style="width: 30px; height: 30px; border: 1px solid rgba(0,0,0,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #667781; font-size: 13px;">
                                                                        <i class="fa fa-download"/>
                                                                    </div>
                                                                </div>

                                                                <!-- 2. Image Preview (Light Mode) -->
                                                                <div invisible="message_type != 'media' or media_type != 'image'" 
                                                                     style="overflow: hidden; border-radius: 6px; margin-bottom: 4px; border: 1px solid rgba(0,0,0,0.05); background: #fff;">
                                                                    <field name="media_file" widget="image" class="w-100 d-block" 
                                                                           style="max-height: 300px; object-fit: contain;" readonly="1"/>
                                                                </div>

                                                                <!-- 3. Text / Caption (Light Mode) -->
                                                                <div class="px-2 pt-1 pb-1" style="white-space: pre-wrap; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14.1px; line-height: 1.5; letter-spacing: 0.01em;">
                                                                    <div invisible="message_type == 'media'">
                                                                        <field name="message_body" readonly="1" nolabel="1"/>
                                                                    </div>
                                                                    <div invisible="message_type != 'media' or not media_caption">
                                                                        <field name="media_caption" readonly="1" nolabel="1"/>
                                                                    </div>
                                                                </div>
                                                                
                                                                <div style="display: flex; justify-content: flex-end; margin-top: -2px;">
                                                                    <button name="action_toggle_full_message" type="object" 
                                                                            string="Read less" class="btn-link p-0 mb-1 px-2" 
                                                                            invisible="not is_long_message"
                                                                            style="font-size: 12.5px; color: #027eb5; text-decoration: none; font-weight: 600; background: transparent; border: none; opacity: 0.9;"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                            
                                                        <!-- Timestamp (Dark Mode) -->
                                                        <div style="text-align: right; font-size: 11px; color: #667781; margin-top: 2px; padding-right: 4px;">
                                                            <span><field name="formatted_create_date" readonly="1" nolabel="1"/></span>
                                                        </div>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                                                    </div>
                                                </div>
                                                
                                            </div>
                                            
                                            
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-4"/>

                                <!-- Delivery Logs Tabs -->
                                <notebook>
                                    <page string="📋 All Logs">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="text-primary fs-5">
                                                <i class="fa fa-list-alt"/> Delivery Activity
                                            </span>
                                            <button name="action_clear_log"
                                                    string="Clear Logs"
                                                    type="object"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    icon="fa-trash"
                                                    invisible="state == 'draft'"/>
                                        </div>
                                        <field name="response_log" readonly="1" nolabel="1" widget="html" 
                                               invisible="not response_log"/>
                                        <div class="p-5 text-center text-muted border-top" invisible="response_log">
                                            <i class="fa fa-info-circle fa-2x mb-2" style="color: #0056b3; opacity: 0.5;"/>
                                            <p>No delivery activity recorded yet.</p>
                                        </div>
                                    </page>

                                    <page string="✅ Success Report">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="text-success fs-5">
                                                <i class="fa fa-check-circle"/> Successfully Delivered
                                            </span>
                                            <div class="d-flex gap-2">
                                                <button name="action_export_success_excel"
                                                        string=" Download Excel"
                                                        type="object"
                                                        icon="fa-download"
                                                        class="btn btn-success btn-sm"
                                                        invisible="not log_success"/>
                                                <button name="action_clear_log"
                                                        string="Clear Logs"
                                                        type="object"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        icon="fa-trash"
                                                        invisible="state == 'draft'"/>
                                            </div>
                                        </div>
                                        <field name="log_success" readonly="1" nolabel="1" widget="html"
                                               invisible="not log_success"/>
                                        <div class="p-5 text-center text-muted border-top" invisible="log_success">
                                            <i class="fa fa-check-circle fa-2x mb-2" style="color: #28a745; opacity: 0.5;"/>
                                            <p>No successful deliveries to report.</p>
                                        </div>
                                    </page>

                                    <page string="❌ Failure Report">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="text-danger fs-5">
                                                <i class="fa fa-exclamation-triangle"/> Failed Deliveries
                                            </span>
                                            <div class="d-flex gap-2">
                                                <button name="action_export_failure_excel"
                                                        string=" Download Excel"
                                                        type="object"
                                                        icon="fa-download"
                                                        class="btn btn-danger btn-sm"
                                                        invisible="not log_failure"/>
                                                <button name="action_clear_log"
                                                        string="Clear Logs"
                                                        type="object"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        icon="fa-trash"
                                                        invisible="state == 'draft'"/>
                                            </div>
                                        </div>
                                        <field name="log_failure" readonly="1" nolabel="1" widget="html"
                                               invisible="not log_failure"/>
                                        <div class="p-5 text-center text-muted border-top" invisible="log_failure">
                                            <i class="fa fa-exclamation-triangle fa-2x mb-2" style="color: #dc3545; opacity: 0.5;"/>
                                            <p>No failed deliveries found.</p>
                                        </div>
                                    </page>
                                </notebook>

                            </div>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">Send Message</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_recipient_type': 'single'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Send your first WhatsApp message!
            </p>
            <p>
                Easily send single or bulk WhatsApp messages via Cloud API.
                <br/>Schedule messages for later delivery.
            </p>
        </field>
    </record>

</odoo>
