<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_model_config_view_list" model="ir.ui.view">
        <field name="name">cloud.model.config.view.list</field>
        <field name="model">cloud.model.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="res_model"/>
                <field name="model_label"/>
                <field name="drive_root_folder_name"/>
                <field name="is_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="cloud_model_config_action" model="ir.actions.act_window">
        <field name="name">Model Configurations</field>
        <field name="res_model">cloud.model.config</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
