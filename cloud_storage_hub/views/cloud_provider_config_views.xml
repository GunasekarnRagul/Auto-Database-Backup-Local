<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Folder List (embedded in config form) -->
    <record id="cloud_root_folder_view_list" model="ir.ui.view">
        <field name="name">cloud.root.folder.view.list</field>
        <field name="model">cloud.root.folder</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="%(action_cloud_folder_wizard)d" string="Bulk Add Folders"
                            type="action" class="btn-primary" icon="fa-plus-circle"/>
                </header>
                <field name="name" placeholder="e.g. Project Documents"/>
                <field name="root_id" readonly="1" optional="hide" placeholder="Auto-generated"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Provider Config Form -->
    <record id="cloud_provider_config_view_form" model="ir.ui.view">
        <field name="name">cloud.provider.config.view.form</field>
        <field name="model">cloud.provider.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_authenticate" string="Connect" type="object" class="btn-primary"
                            invisible="is_connected or (provider_type in ('gdrive','onedrive','dropbox') and refresh_token)"/>
                    <button name="action_authenticate" string="Re-Authorize" type="object" class="btn-outline-primary"
                            invisible="not refresh_token or provider_type in ('aws','nextcloud')"/>
                    <button name="action_disconnect" string="Disconnect" type="object" class="btn-danger"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                    <field name="active" invisible="1"/>
                    <field name="is_connected" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. My AWS Bucket"/></h1>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="provider_type" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle" readonly="state != 'connected'"/>
                            <field name="root_folder_count" invisible="not is_connected"/>
                            <field name="provider_label" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- ── AWS S3 ── -->
                        <page string="Credentials" name="credentials_aws" invisible="provider_type != 'aws'">
                            <group string="AWS S3 Credentials">
                                <field name="aws_access_key_id" placeholder="e.g. AKIA..." readonly="is_connected"/>
                                <field name="aws_secret_access_key" password="True" readonly="is_connected"/>
                                <field name="aws_region" placeholder="e.g. us-east-1" readonly="is_connected"/>
                                <field name="aws_s3_bucket_name" placeholder="e.g. my-odoo-bucket" readonly="is_connected"/>
                                <div colspan="2" class="alert alert-success" role="status" invisible="not is_connected">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Connected to AWS S3!</strong>
                                </div>
                            </group>
                            <group string="Sharing">
                                <field name="share_link_expiry_days"
                                       string="Presigned URL Expiry (Days, max 7)"
                                       help="AWS S3 presigned URLs expire after this many days (maximum 7)."/>
                            </group>
                        </page>
                        <!-- ── Google Drive ── -->
                        <page string="Credentials" name="credentials_gdrive" invisible="provider_type != 'gdrive'">
                            <group string="Google Drive OAuth 2.0">
                                <field name="client_id" placeholder="Google Client ID" readonly="state == 'connected'"/>
                                <field name="client_secret" password="True" placeholder="Google Client Secret" readonly="state == 'connected'"/>
                                <field name="redirect_uri" readonly="1" string="Redirect URI (copy to Google Console)"/>
                                <div colspan="2" class="alert alert-info" role="status" invisible="state == 'connected'">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>How to Connect Google Drive:</strong>
                                    <ul class="mt-2 mb-0 ms-3" style="list-style-type: decimal;">
                                        <li>Log in to the <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a>.</li>
                                        <li>Navigate to <b>APIs &amp; Services &gt; Credentials</b>.</li>
                                        <li>Click on your <b>OAuth 2.0 Client ID</b> to edit it (or create a new one).</li>
                                        <li>Scroll down to <b>Authorized redirect URIs</b> and click <b>ADD URI</b>.</li>
                                        <li>Copy the <b>Redirect URI</b> from the field above and paste it there.</li>
                                        <li>Save your changes in Google Cloud, then come back here and click <b>Connect</b>.</li>
                                    </ul>
                                </div>
                                <div colspan="2" class="alert alert-success" role="status" invisible="state != 'connected'">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Connected to Google Drive!</strong>
                                </div>
                            </group>
                        </page>
                        <!-- ── OneDrive ── -->
                        <page string="Credentials" name="credentials_onedrive" invisible="provider_type != 'onedrive'">
                            <group string="Microsoft OneDrive OAuth 2.0">
                                <field name="client_id" placeholder="Application (Client) ID" readonly="state == 'connected'"/>
                                <field name="client_secret" password="True" placeholder="Client Secret" readonly="state == 'connected'"/>
                                <field name="redirect_uri" readonly="1" string="Redirect URI (copy to Azure App Registration)"/>
                                <div colspan="2" class="alert alert-info" role="status" invisible="state == 'connected'">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Setup:</strong> Add the Redirect URI above to your Azure App Registration → Authentication → Redirect URIs.
                                </div>
                                <div colspan="2" class="alert alert-success" role="status" invisible="state != 'connected'">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Connected to OneDrive!</strong>
                                </div>
                            </group>
                        </page>
                        <!-- ── Nextcloud ── -->
                        <page string="Credentials" name="credentials_nextcloud" invisible="provider_type != 'nextcloud'">
                            <group string="Nextcloud — WebDAV / Basic Auth">
                                <field name="nextcloud_url" placeholder="https://cloud.yourcompany.com" readonly="is_connected"/>
                                <field name="nc_username" placeholder="Your Nextcloud username" readonly="is_connected"/>
                                <field name="nc_app_password" password="True" placeholder="App Password (recommended)" readonly="is_connected"/>
                                <div colspan="2" class="alert alert-info" role="status" invisible="is_connected">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Tip:</strong> Generate an <em>App Password</em> in Nextcloud → Settings → Security → App Passwords.
                                </div>
                                <div colspan="2" class="alert alert-success" role="status" invisible="not is_connected">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Connected to Nextcloud!</strong>
                                </div>
                            </group>
                        </page>
                        <!-- ── Dropbox ── -->
                        <page string="Credentials" name="credentials_dropbox" invisible="provider_type != 'dropbox'">
                            <group string="Dropbox OAuth 2.0">
                                <field name="client_id" placeholder="Dropbox App Key" readonly="state == 'connected'"/>
                                <field name="client_secret" password="True" placeholder="Dropbox App Secret" readonly="state == 'connected'"/>
                                <field name="redirect_uri" readonly="1" string="Redirect URI (copy to Dropbox App Console)"/>
                                <div colspan="2" class="alert alert-info" role="status" invisible="state == 'connected'">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Setup:</strong> Add the Redirect URI above to your Dropbox App Console → Settings → Redirect URIs.
                                </div>
                                <div colspan="2" class="alert alert-success" role="status" invisible="state != 'connected'">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Connected to Dropbox!</strong>
                                </div>
                            </group>
                        </page>
                        <!-- ── Folder Configuration ── -->
                        <page string="Root Folders" name="root_folders" invisible="state != 'connected'">
                            <div class="d-flex gap-3 mb-3">
                                <button name="action_configure_roots" string="Manage Folders"
                                        type="object" class="btn-primary" icon="fa-folder-open"/>
                                <button name="action_sync_all" string="Sync All Folders"
                                        type="object" class="btn-outline-secondary" icon="fa-refresh"/>
                                <button name="action_bulk_add_folders" string="Bulk Add Folders"
                                        type="object" class="btn-outline-secondary" icon="fa-plus"/>
                            </div>
                            <field name="root_ids" widget="one2many_list">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="root_id" readonly="1" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="cloud_provider_config_view_list" model="ir.ui.view">
        <field name="name">cloud.provider.config.view.list</field>
        <field name="model">cloud.provider.config</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'connected'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="provider_type" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'error'"/>
                <field name="root_folder_count"/>
                <field name="active" widget="boolean_toggle" readonly="state != 'connected'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="cloud_provider_config_view_kanban" model="ir.ui.view">
        <field name="name">cloud.provider.config.view.kanban</field>
        <field name="model">cloud.provider.config</field>
        <field name="arch" type="xml">
            <kanban class="o_cloud_kanban" sample="1" quick_create="false">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="state"/>
                <field name="active"/>
                <field name="root_folder_count"/>
                <field name="provider_label"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_cloud_card">
                            <div t-attf-class="o_cloud_card_accent #{record.state.raw_value == 'connected' ? 'accent-success' : 'accent-warning'}"/>
                            <div class="o_cloud_card_header">
                                <div class="d-flex align-items-center gap-3 flex-grow-1">
                                    <div class="o_cloud_card_icon">
                                        <t t-if="record.provider_type.raw_value == 'aws'">
                                            <img src="/cloud_storage_hub/static/description/aws.png" alt="AWS" style="width:28px; height:28px; object-fit: contain;"/>
                                        </t>
                                        <t t-elif="record.provider_type.raw_value == 'gdrive'">
                                            <img src="/cloud_storage_hub/static/description/google-drive.png" alt="Google Drive" style="width:28px; height:28px; object-fit: contain;"/>
                                        </t>
                                        <t t-elif="record.provider_type.raw_value == 'onedrive'">
                                            <img src="/cloud_storage_hub/static/description/microsoft-onedrive.png" alt="OneDrive" style="width:28px; height:28px; object-fit: contain;"/>
                                        </t>
                                        <t t-elif="record.provider_type.raw_value == 'nextcloud'">
                                            <img src="/cloud_storage_hub/static/description/nextcloud.png" alt="Nextcloud" style="width:28px; height:28px; object-fit: contain;"/>
                                        </t>
                                        <t t-elif="record.provider_type.raw_value == 'dropbox'">
                                            <img src="/cloud_storage_hub/static/description/dropbox.png" alt="Dropbox" style="width:28px; height:28px; object-fit: contain;"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-cloud text-muted" style="font-size:28px"/>
                                        </t>
                                    </div>
                                    <div>
                                        <div class="o_cloud_card_title"><field name="name"/></div>
                                        <div class="o_cloud_card_subtitle"><field name="provider_label"/></div>
                                    </div>
                                </div>
                                <div class="o_cloud_card_menu o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret" role="button" data-bs-toggle="dropdown" href="#">
                                        <i class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">
                                            <i class="fa fa-pencil me-2 text-primary"/>Edit
                                        </a>
                                        <a role="menuitem" type="delete" class="dropdown-item text-danger">
                                            <i class="fa fa-trash-o me-2"/>Delete
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_cloud_card_details pt-2 border-top mx-3" style="font-size:11px;color:#666;">
                                <div class="d-flex justify-content-between">
                                    <span><i class="fa fa-folder-open-o me-1"/> Folders:</span>
                                    <span class="fw-bold"><field name="root_folder_count"/></span>
                                </div>
                            </div>
                            <div class="o_cloud_card_footer">
                                <span t-if="record.state.raw_value == 'connected'" class="o_cloud_status_badge badge-connected">
                                    <i class="fa fa-check-circle"/> Connected
                                </span>
                                <span t-if="record.state.raw_value == 'draft'" class="o_cloud_status_badge badge-draft">
                                    <i class="fa fa-clock-o"/> Not Connected
                                </span>
                                <field name="active" widget="boolean_toggle" readonly="state != 'connected'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="cloud_provider_config_view_search" model="ir.ui.view">
        <field name="name">cloud.provider.config.view.search</field>
        <field name="model">cloud.provider.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="AWS S3"      name="aws"       domain="[('provider_type','=','aws')]"/>
                <filter string="Google Drive" name="gdrive"   domain="[('provider_type','=','gdrive')]"/>
                <filter string="OneDrive"     name="onedrive" domain="[('provider_type','=','onedrive')]"/>
                <filter string="Nextcloud"    name="nextcloud" domain="[('provider_type','=','nextcloud')]"/>
                <filter string="Dropbox"      name="dropbox"  domain="[('provider_type','=','dropbox')]"/>
                <separator/>
                <filter string="Connected"    name="connected" domain="[('state','=','connected')]"/>
                <filter string="Archived"     name="archived"  domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="cloud_provider_config_action" model="ir.actions.act_window">
        <field name="name">Cloud Providers</field>
        <field name="res_model">cloud.provider.config</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="cloud_provider_config_view_search"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect your first Cloud Provider!
            </p>
            <p>
                Add AWS S3, Google Drive, OneDrive, Nextcloud, or Dropbox to sync your Odoo documents seamlessly.
            </p>
        </field>
    </record>
</odoo>
