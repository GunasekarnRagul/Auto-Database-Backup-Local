<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron: Push pending files to cloud (every 30 min) -->
    <record id="cloud_hub_cron_sync" model="ir.cron">
        <field name="name">Cloud Storage Hub — Auto Sync</field>
        <field name="model_id" ref="model_cloud_provider_config"/>
        <field name="state">code</field>
        <field name="code">
env['cloud.sync.aws'].sudo().with_context(sync_type='cron').fetch_and_sync_files()
env['cloud.sync.gdrive'].sudo().with_context(sync_type='cron').fetch_and_sync_files()
env['cloud.sync.onedrive'].sudo().with_context(sync_type='cron').fetch_and_sync_files()
env['cloud.sync.nextcloud'].sudo().with_context(sync_type='cron').fetch_and_sync_files()
env['cloud.sync.dropbox'].sudo().with_context(sync_type='cron').fetch_and_sync_files()
        </field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
        <field name="priority">10</field>
    </record>
</odoo>
