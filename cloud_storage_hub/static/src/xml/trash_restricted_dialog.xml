<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cloud_storage_hub.TrashRestrictedDialog">
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                    <!-- Top accent bar -->
                    <div class="p-1 bg-warning"></div>
                    
                    <div class="modal-body text-center p-5">
                        <div class="mb-4 d-inline-flex align-items-center justify-content-center" 
                             style="width: 80px; height: 80px; border-radius: 50%; background-color: #fff4e5; color: #ff9800;">
                            <i class="fa fa-exclamation-triangle" style="font-size: 36px;"/>
                        </div>
                        
                        <h4 class="mb-3 fw-bold text-dark" style="letter-spacing: -0.5px;">Action Restricted</h4>
                        
                        <p class="text-muted mb-4 px-3" style="font-size: 1.05rem; line-height: 1.6;">
                            You cannot individually restore or delete items from within a trashed folder. 
                            Because your <strong>root folder</strong> is still in the trash tab, 
                            please restore the top-level parent folder first.
                        </p>
                        
                        <button type="button" 
                                class="btn btn-warning btn-lg w-100 rounded-pill shadow-sm" 
                                t-on-click="props.close"
                                style="color: #fff; font-weight: 600; padding: 12px 16px;">
                            Got it
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
