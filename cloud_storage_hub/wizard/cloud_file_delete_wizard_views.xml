<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_file_delete_wizard_view_form" model="ir.ui.view">
        <field name="name">cloud.file.delete.wizard.form</field>
        <field name="model">cloud.file.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Files">
                <sheet>
                    <group>
                        <field name="delete_remote" string="Also delete from cloud storage?"/>
                    </group>
                    <field name="file_ids" widget="many2many_tags"/>
                </sheet>
                <footer>
                    <button name="action_confirm_delete" string="Confirm Delete" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
