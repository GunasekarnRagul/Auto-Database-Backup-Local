<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud_duplicate_pruner_wizard_view_form" model="ir.ui.view">
        <field name="name">cloud.duplicate.pruner.wizard.form</field>
        <field name="model">cloud.duplicate.pruner.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate File Pruner">
                <sheet>
                    <p class="text-muted">Files with identical names and sizes found across your cloud storage.</p>
                    <button name="action_load_duplicates" string="Scan for Duplicates" type="object" class="btn-primary mb-3"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="file_id"/>
                            <field name="selected"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_prune" string="Delete Selected" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
