<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_ai_agent_list" model="ir.ui.view">
        <field name="name">ai.agent.list</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <list string="AI Agents">
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="temperature"/>
                <field name="max_tokens"/>
                <field name="language"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view with 3 tabs -->
    <record id="view_ai_agent_form" model="ir.ui.view">
        <field name="name">ai.agent.form</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Agent Name"/></h1>
                    </div>
                    <notebook>

                        <!-- TAB 1: General -->
                        <page string="General">
                            <group>
                                <field name="system_prompt"
                                       widget="text"
                                       placeholder="You are a helpful AI assistant for Odoo..."
                                       style="min-height: 120px;"/>
                                <field name="temperature"/>
                                <field name="max_tokens"/>
                                <field name="language"/>
                                <field name="response_format"/>
                                <field name="is_default"/>
                            </group>
                        </page>

                        <!-- TAB 2: Model Access -->
                        <page string="Model Access">
                            <div class="alert alert-info" role="alert">
                                Select which Odoo models this agent is allowed to read.
                                The agent is strictly read-only and cannot modify any data.
                            </div>
                            <field name="permission_ids">
                                <list editable="bottom">
                                    <field name="model_id" string="Model"/>
                                    <field name="model_name" string="Technical Name" readonly="1"/>
                                    <field name="can_read" string="Allow Read" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 3: Advanced -->
                        <page string="Advanced">
                            <group>
                                <field name="active"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_ai_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">ai.agent</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
