<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- ============================================================ -->
    <!-- Root Menu -->
    <!-- ============================================================ -->
    <menuitem id="menu_chatgpt_ai_root"
              name="ChatGPT AI Assistance"
              web_icon="chatgpt_ai_assistance_ca,static/src/img/ai_avatar.png"
              sequence="100"/>

    <!-- ============================================================ -->
    <!-- Child Menu 1: Chat AI (gated by group_ai_connected) -->
    <!-- ============================================================ -->
    <menuitem id="menu_chat_ai"
              name="Chat AI"
              parent="menu_chatgpt_ai_root"
              action="action_chat_ai_main"
              sequence="10"/>

    <!-- ============================================================ -->
    <!-- Child Menu 3: Configuration (admin only) -->
    <!-- ============================================================ -->
    <menuitem id="menu_configuration"
              name="Configuration"
              parent="menu_chatgpt_ai_root"
              sequence="30"/>

    <!-- Sub-menu 3.1: Connector -->
    <menuitem id="menu_ai_connector"
              name="Connector"
              parent="menu_configuration"
              action="action_ai_connector"
              sequence="10"/>

    <!-- Sub-menu 3.2: AI Agent -->
    <menuitem id="menu_ai_agent"
              name="AI Agent"
              parent="menu_configuration"
              action="action_ai_agent"
              sequence="20"/>



</odoo>
