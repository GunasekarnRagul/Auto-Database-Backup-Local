<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for conversation detail -->
    <record id="view_ai_conversation_form" model="ir.ui.view">
        <field name="name">ai.conversation.form</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_open_in_chat"
                            type="object"
                            string="Open in Chat AI"
                            class="btn btn-primary"/>
                    <button name="action_export"
                            type="object"
                            string="Export"
                            class="btn btn-secondary"/>
                    <button name="unlink"
                            type="object"
                            string="Delete"
                            class="btn btn-danger"
                            confirm="Delete this conversation and all its messages?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="agent_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="message_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Time"/>
                            <field name="role"/>
                            <field name="content" string="Message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
