<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="chatgpt_ai_assistance_ca.ChatAIComponent">
    <div class="chat-ai-root">

        <!-- SIDEBAR DRAWER -->
        <DrawerComponent
            activeConversationId="state.conversation_id"
            onSelectConversation.bind="loadConversation"
            onNewConversation.bind="newConversation"
        />

        <!-- MAIN CHAT AREA -->
        <div class="chat-ai-main">

            <!-- AGENT BADGE (top center) -->
            <div class="agent-badge-wrapper">
                <div class="agent-badge" t-on-click="toggleAgentDropdown">
                    <span class="agent-icon">✦</span>
                    <span t-esc="state.active_agent ? state.active_agent.name : 'No Agent'"/>
                    <span class="agent-chevron">▾</span>
                </div>
                <!-- Agent dropdown -->
                <t t-if="state.show_agent_dropdown">
                    <div class="agent-dropdown">
                        <t t-foreach="state.agents" t-as="agent" t-key="agent.id">
                            <div class="agent-option" t-on-click="() => this.selectAgent(agent)">
                                <span class="agent-check" t-if="state.active_agent and state.active_agent.id === agent.id">✓</span>
                                <span class="agent-check" t-else=""> </span>
                                <strong t-esc="agent.name"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>

            <!-- MESSAGE THREAD -->
            <div class="message-thread" t-ref="messageThread">

                <!-- EMPTY STATE -->
                <t t-if="state.messages.length === 0 and !state.loading">
                    <div class="empty-state">
                        <div class="empty-icon">✦</div>
                        <h2>ChatGPT AI Assistant</h2>
                        <p>Ask anything about your Odoo business data</p>
                        <div class="suggestion-chips">
                            <div class="suggestion-chip" t-on-click="() => this.selectSuggestion('Show last month sales report')">
                                📊 Show last month's sales report
                            </div>
                            <div class="suggestion-chip" t-on-click="() => this.selectSuggestion('List all unpaid invoices')">
                                📄 List all unpaid invoices
                            </div>
                            <div class="suggestion-chip" t-on-click="() => this.selectSuggestion('Products with low stock')">
                                📦 Products with low stock
                            </div>
                            <div class="suggestion-chip" t-on-click="() => this.selectSuggestion('Top customers this quarter')">
                                👥 Top customers this quarter
                            </div>
                        </div>
                    </div>
                </t>

                <!-- MESSAGES -->
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <ChatMessage message="msg"/>
                </t>

                <!-- TYPING INDICATOR -->
                <t t-if="state.loading">
                    <div class="typing-indicator">
                        <div class="ai-avatar typing-avatar">✦</div>
                        <div class="typing-dots">
                            <span class="dot dot-1"/>
                            <span class="dot dot-2"/>
                            <span class="dot dot-3"/>
                        </div>
                    </div>
                </t>

            </div>

            <!-- INPUT BAR -->
            <div class="chat-input-bar">
                <div class="input-row">
                    <textarea
                        t-ref="chatInput"
                        class="chat-textarea"
                        placeholder="Ask anything about your Odoo data..."
                        t-att-value="state.input_text"
                        t-on-input="handleInput"
                        t-on-keydown="handleKeyDown"
                        t-att-disabled="state.loading"
                        rows="1"
                    />
                    <button class="send-btn" t-on-click="sendMessage"
                            t-att-disabled="state.loading or !state.input_text.trim()">
                        <t t-if="state.loading">
                            <span class="send-spinner"/>
                        </t>
                        <t t-else="">
                            <span class="send-arrow">➤</span>
                        </t>
                    </button>
                </div>
                <div class="input-disclaimer">
                    AI can make mistakes. Verify important data in Odoo directly.
                </div>
            </div>

        </div>
    </div>
</t>

</templates>
