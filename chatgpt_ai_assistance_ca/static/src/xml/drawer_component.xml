<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="chatgpt_ai_assistance_ca.DrawerComponent">
    <div t-att-class="'chat-drawer ' + (state.is_open ? 'drawer-open' : 'drawer-closed')">

        <!-- Toggle button (always visible) -->
        <div class="drawer-toggle-btn" t-on-click="toggleDrawer">
            <t t-if="state.is_open">✕</t>
            <t t-else="">☰</t>
        </div>

        <t t-if="state.is_open">
            <!-- New Chat Button -->
            <button class="new-chat-btn" t-on-click="newChat">
                <span class="new-chat-icon">+</span> New Conversation
            </button>

            <!-- HISTORY -->
            <div class="history-section">
                <t t-foreach="getGroupedConversations()" t-as="group" t-key="group[0]">
                    <div class="group-label" t-esc="group[0]"/>
                    <t t-foreach="group[1]" t-as="conv" t-key="conv.id">
                        <div t-att-class="'history-item' + (props.activeConversationId === conv.id ? ' active' : '')"
                             t-on-click="() => this.selectConversation(conv.id)">

                            <!-- Editing mode -->
                            <t t-if="state.editing_id === conv.id">
                                <input t-att-value="state.edit_name"
                                       t-on-input="handleRenameInput"
                                       t-on-blur="() => this.confirmRename(conv)"
                                       t-on-keydown="(ev) => this.handleRenameKeydown(conv, ev)"
                                       class="rename-input"
                                       t-on-click.stop="() => {}"/>
                            </t>

                            <!-- Normal mode -->
                            <t t-else="">
                                <div class="conv-info">
                                    <span class="conv-name" t-esc="truncateName(conv.name)"/>
                                    <span class="conv-time" t-esc="formatRelativeTime(conv.create_date)"/>
                                </div>
                                <div class="item-actions">
                                    <span t-on-click.stop="(ev) => this.startRename(conv, ev)" title="Rename">✏</span>
                                    <span t-on-click.stop="(ev) => this.toggleFavorite(conv, ev)" title="Star">
                                        <t t-if="conv.is_favorite">★</t>
                                        <t t-else="">☆</t>
                                    </span>
                                    <span t-on-click.stop="(ev) => this.deleteConversation(conv.id, ev)" title="Delete">🗑</span>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </div>

            <!-- FAVORITES -->
            <t t-if="state.favorites.length">
                <div class="favorites-section">
                    <div class="section-title">★ Favorite Prompts</div>
                    <t t-foreach="state.favorites" t-as="fav" t-key="fav.id">
                        <div class="fav-item" t-on-click="() => this.selectFavoritePrompt(fav.prompt_text)">
                            <div class="fav-header">
                                <span class="fav-name" t-esc="fav.name"/>
                                <span t-if="fav.is_global" class="global-badge">Global</span>
                            </div>
                            <div class="fav-preview" t-esc="(fav.prompt_text || '').slice(0, 50)"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>

    </div>
</t>

</templates>
