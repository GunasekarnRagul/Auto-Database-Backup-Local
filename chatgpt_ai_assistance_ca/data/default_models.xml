<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default Connector (api_key left empty — admin must fill in) -->
    <record id="default_ai_connector" model="ai.connector">
        <field name="name">Default Connector</field>
        <field name="api_key"></field>
        <field name="model_name">gpt-4o</field>
        <field name="request_timeout">30</field>
    </record>

    <!-- Default AI Agent -->
    <record id="default_ai_agent" model="ai.agent">
        <field name="name">General Assistant</field>
        <field name="system_prompt">You are a helpful AI assistant integrated into Odoo.
Your job is to help users understand their business data by answering questions
and displaying relevant records. Always be concise, professional, and accurate.
You are read-only. You cannot create, edit, or delete any records.</field>
        <field name="temperature">0.3</field>
        <field name="max_tokens">1500</field>
        <field name="language">en</field>
        <field name="is_default" eval="True"/>
    </record>

    <!-- Default Permissions: 14 models for the General Assistant -->
    <record id="perm_sale_order" model="ai.agent.permission">
        <field name="agent_id" ref="default_ai_agent"/>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="can_read" eval="True"/>
    </record>
    <record id="perm_sale_order_line" model="ai.agent.permission">
        <field name="agent_id" ref="default_ai_agent"/>
        <field name="model_id" ref="sale.model_sale_order_line"/>
