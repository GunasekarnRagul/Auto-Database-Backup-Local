<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_aws_s3" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cloud.backup.aws</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="91"/>
        <field name="inherit_id" ref="auto_backup_db_cloud.res_config_settings_view_form_cloud_backup"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cloud_provider_block']" position="after">
                <block title="AWS S3 Configuration" name="aws_s3_config_block"
                       invisible="cloud_provider != 'aws_s3'">
                    <setting title="Access Key ID" help="Enter your AWS Access Key ID.">
                        <field name="s3_access_key" placeholder="e.g. AKIAIOSFODNN7EXAMPLE"/>
                    </setting>
                    <setting title="Secret Access Key" help="Enter your AWS Secret Access Key.">
                        <field name="s3_secret_key" password="True" placeholder="••••••••••••••••"/>
                    </setting>
                    <setting title="Bucket Name" help="Enter the S3 Bucket Name for database backups.">
                        <field name="s3_bucket" placeholder="e.g. my-odoo-backups"/>
                    </setting>
                    <setting title="Region" help="AWS Region where your S3 bucket resides.">
                        <field name="s3_region" placeholder="e.g. us-east-1"/>
                    </setting>

                    <setting string="Connection Status" help="Test the connection to your S3 bucket.">
                        <div class="content-group mt-2">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <button name="action_test_s3_connection"
                                        type="object"
                                        string="Test Connection"
                                        class="btn btn-primary"
                                        invisible="s3_is_connection_tested or not s3_access_key or not s3_secret_key or not s3_bucket">
                                    <i class="fa fa-plug me-2"/> Test Connection
                                </button>

                                <div class="d-flex align-items-center gap-2" invisible="not s3_is_connection_tested">
                                    <div class="alert alert-success d-flex align-items-center py-2 px-3 m-0 border-0 rounded-3 shadow-sm">
                                        <i class="fa fa-check-circle me-2 fs-5"/>
                                        <span class="small fw-bold">Connected Successfully</span>
                                    </div>

                                    <button name="action_reset_s3_connection"
                                            type="object"
                                            class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2">
                                        <i class="fa fa-refresh"/>
                                        <span>Reset</span>
                                    </button>

                                    <button name="action_disconnect_s3"
                                            type="object"
                                            class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2"
                                            confirm="Are you sure you want to disconnect S3 and reset all credentials?">
                                        <i class="fa fa-power-off"/>
                                        <span>Disconnect</span>
                                    </button>
                                </div>
                            </div>
                            <field name="s3_is_connection_tested" invisible="1"/>
                        </div>
                    </setting>
                </block>
                <div invisible="cloud_provider != 'aws_s3' or not s3_is_connection_tested" class="mt-4">
                    <notebook>
                        <page string="Auto Backup" name="s3_auto_backup_page">
                            <block title="S3 Auto Backup Settings" name="s3_backup_config_block">
                                <setting title="Enable S3 Auto Backup" help="Automatically backup the database to AWS S3.">
                                    <field name="s3_backup_active"/>
                                </setting>
                                <setting title="Backup Frequency" help="Set how often the database should be backed up to S3." invisible="not s3_backup_active">
                                    <div class="content-group">
                                        <div class="mt16">
                                            <span>Every </span>
                                            <field name="s3_backup_interval_number" class="oe_inline"/>
                                            <field name="s3_backup_interval_type" class="oe_inline" style="margin-left:10px"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Sync Rules" help="Define which databases should be backed up to S3 automatically.">
                                    <div class="content-group">
                                        <field name="s3_sync_scope" widget="radio" class="w-50 mb-3"/>
                                        <div invisible="s3_sync_scope != 'selective'" class="mt-2 mb-3">
                                            <label for="s3_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                            <field name="s3_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Last Backup" help="Date and time of the last successful S3 backup." invisible="not s3_backup_last_run">
                                    <field name="s3_backup_last_run" widget="date"/>
                                </setting>
                            </block>
                        </page>

                        <page string="Manual Backup" name="s3_manual_backup_page">
                            <block title="S3 Manual Backup Settings" name="s3_manual_backup_block">
                                <setting title="Sync Rules" help="Define which databases to include in the manual S3 backup.">
                                    <div class="content-group">
                                        <field name="s3_manual_sync_scope" widget="radio" class="w-50 mb-3"/>
                                        <div invisible="s3_manual_sync_scope != 'selective'" class="mt-2 mb-3">
                                            <label for="s3_manual_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                            <field name="s3_manual_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Manual Sync" help="Trigger a manual S3 backup immediately.">
                                    <div class="content-group">
                                        <div class="mt-2">
                                            <button name="action_manual_sync"
                                                    type="object"
                                                    string="Manual BackUp"
                                                    class="btn btn-primary"
                                                    confirm="Are you sure you want to start the manual backup to AWS S3?"/>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </page>

                        <page string="Retention Policy" name="s3_retention_policy_page">
                            <block title="S3 Retention Policy" name="s3_retention_policy_block">
                                <setting title="Retention Type" help="Choose how you want to prune old S3 backups.">
                                    <field name="s3_retention_type" widget="radio"/>
                                </setting>
                                <setting title="Retention Limit" invisible="s3_retention_type == 'none'">
                                    <div invisible="s3_retention_type != 'count'">
                                        <div class="d-flex align-items-center">
                                            <span>Keep last </span>
                                            <field name="s3_retention_count" class="mx-2 oe_inline fw-bold"/>
                                            <span> backups</span>
                                        </div>
                                    </div>
                                    <div invisible="s3_retention_type != 'days'">
                                        <div class="d-flex align-items-center">
                                            <span>Keep for </span>
                                            <field name="s3_retention_days" class="mx-2 oe_inline fw-bold"/>
                                            <span> days</span>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </page>
                    </notebook>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
