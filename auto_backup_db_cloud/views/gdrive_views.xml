<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gdrive" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cloud.backup.gdrive</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="92"/>
        <field name="inherit_id" ref="auto_backup_db_cloud.res_config_settings_view_form_cloud_backup"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cloud_provider_block']" position="after">
                <block title="Google Drive Configuration" name="gdrive_config_block"
                       invisible="cloud_provider != 'gdrive'">
                    <setting title="Client ID" help="Enter your Google OAuth 2.0 Client ID.">
                        <field name="gdrive_client_id" placeholder="e.g. 123456789.apps.googleusercontent.com"/>
                    </setting>
                    <setting title="Client Secret" help="Enter your Google OAuth 2.0 Client Secret.">
                        <field name="gdrive_client_secret" password="True" placeholder="••••••••••••••••"/>
                    </setting>
                    <setting title="Folder ID" help="Google Drive Folder ID where backups will be stored. Leave empty for root.">
                        <field name="gdrive_folder_id" placeholder="e.g. 1aBcDeFgHiJkLmNoPqRsTuVwXyZ"/>
                    </setting>

                    <setting string="Authorization &amp; Setup" help="Connect Odoo to your Google Drive account.">
                        <div class="content-group mt-2">
                            <div class="alert alert-info py-2 mb-3 border-0 rounded-3 shadow-sm d-flex align-items-start">
                                <i class="fa fa-info-circle mt-1 me-3 fs-4 text-info"/>
                                <div>
                                    <h6 class="alert-heading fw-bold mb-1">How to authorize:</h6>
                                    <ol class="ps-3 mb-0 small">
                                        <li>Go to the <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="fw-bold text-decoration-underline">Google Cloud Console</a>.</li>
                                        <li>Create an OAuth 2.0 Client ID (Web Application).</li>
                                        <li>Add the <b>Redirect URI</b> below to the <i>Authorized redirect URIs</i> section.</li>
                                        <li>Enable the <b>Google Drive API</b> for your project.</li>
                                    </ol>
                                </div>
                            </div>

                            <div class="p-3 border rounded-3 bg-light mb-4 shadow-sm">
                                <label for="gdrive_redirect_uri" class="d-block small text-muted text-uppercase fw-bold mb-1">Redirect URI</label>
                                <div class="d-flex align-items-center">
                                    <field name="gdrive_redirect_uri" widget="copy_clipboard" readonly="1" class="fw-bold text-primary flex-grow-1"/>
                                    <span class="ms-2 text-muted" title="This URI is automatically formed based on your current browser URL.">
                                        <i class="fa fa-question-circle cursor-pointer"/>
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <button name="action_gdrive_authenticate"
                                        type="object"
                                        string="Connect Google Drive"
                                        class="btn btn-primary"
                                        invisible="gdrive_refresh_token or not gdrive_client_id or not gdrive_client_secret">
                                    <i class="fa fa-google me-2"/> Connect
                                </button>

                                <div class="d-flex align-items-center gap-2" invisible="not gdrive_refresh_token">
                                    <div class="alert alert-success d-flex align-items-center py-2 px-3 m-0 border-0 rounded-3 shadow-sm">
                                        <i class="fa fa-check-circle me-2 fs-5"/>
                                        <span class="small fw-bold">Authorized Successfully</span>
                                    </div>

                                    <button name="action_gdrive_authenticate"
                                            type="object"
                                            class="btn btn-outline-secondary btn-sm d-inline-flex flex-column align-items-center"
                                            invisible="not gdrive_client_id or not gdrive_client_secret">
                                        <i class="fa fa-refresh mb-1"/>
                                        <span>Re-connect</span>
                                    </button>

                                    <button name="action_gdrive_disconnect"
                                            type="object"
                                            class="btn btn-outline-danger btn-sm d-inline-flex flex-column align-items-center"
                                            confirm="Are you sure you want to disconnect Google Drive and reset all credentials?">
                                        <i class="fa fa-power-off mb-1"/>
                                        <span>Disconnect</span>
                                    </button>
                                </div>
                            </div>
                            <field name="gdrive_refresh_token" invisible="1"/>
                        </div>
                    </setting>
                </block>
                <div invisible="cloud_provider != 'gdrive' or not gdrive_refresh_token" class="mt-4">
                    <notebook>
                        <page string="Auto Backup" name="gdrive_auto_backup_page">
                            <block title="GDrive Auto Backup Settings" name="gdrive_backup_config_block">
                                <setting title="Enable GDrive Auto Backup" help="Automatically backup the database to Google Drive.">
                                    <field name="gdrive_backup_active"/>
                                </setting>
                                <setting title="Backup Frequency" help="Set how often the database should be backed up to GDrive." invisible="not gdrive_backup_active">
                                    <div class="content-group">
                                        <div class="mt16">
                                            <span>Every </span>
                                            <field name="gdrive_backup_interval_number" class="oe_inline"/>
                                            <field name="gdrive_backup_interval_type" class="oe_inline" style="margin-left:10px"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Sync Rules" help="Define which databases should be backed up to GDrive automatically.">
                                    <div class="content-group">
                                        <field name="gdrive_sync_scope" widget="radio" class="w-50 mb-3"/>
                                        <div invisible="gdrive_sync_scope != 'selective'" class="mt-2 mb-3">
                                            <label for="gdrive_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                            <field name="gdrive_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Last Backup" help="Date and time of the last successful GDrive backup." invisible="not gdrive_backup_last_run">
                                    <field name="gdrive_backup_last_run" widget="date"/>
                                </setting>
                            </block>
                        </page>

                        <page string="Manual Backup" name="gdrive_manual_backup_page">
                            <block title="GDrive Manual Backup Settings" name="gdrive_manual_backup_block">
                                <setting title="Sync Rules" help="Define which databases to include in the manual GDrive backup.">
                                    <div class="content-group">
                                        <field name="gdrive_manual_sync_scope" widget="radio" class="w-50 mb-3"/>
                                        <div invisible="gdrive_manual_sync_scope != 'selective'" class="mt-2 mb-3">
                                            <label for="gdrive_manual_selected_db_ids" class="fw-bold small text-muted text-uppercase mb-1 d-block">Select Databases</label>
                                            <field name="gdrive_manual_selected_db_ids" widget="many2many_tags" placeholder="Search databases..." class="w-100"/>
                                        </div>
                                    </div>
                                </setting>
                                <setting title="Manual Sync" help="Trigger a manual GDrive backup immediately.">
                                    <div class="content-group">
                                        <div class="mt-2">
                                            <button name="action_manual_sync"
                                                    type="object"
                                                    string="Manual BackUp"
                                                    class="btn btn-primary"
                                                    confirm="Are you sure you want to start the manual backup to Google Drive?"/>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </page>

                        <page string="Retention Policy" name="gdrive_retention_policy_page">
                            <block title="GDrive Retention Policy" name="gdrive_retention_policy_block">
                                <setting title="Retention Type" help="Choose how you want to prune old GDrive backups.">
                                    <field name="gdrive_retention_type" widget="radio"/>
                                </setting>
                                <setting title="Retention Limit" invisible="gdrive_retention_type == 'none'">
                                    <div invisible="gdrive_retention_type != 'count'">
                                        <div class="d-flex align-items-center">
                                            <span>Keep last </span>
                                            <field name="gdrive_retention_count" class="mx-2 oe_inline fw-bold"/>
                                            <span> backups</span>
                                        </div>
                                    </div>
                                    <div invisible="gdrive_retention_type != 'days'">
                                        <div class="d-flex align-items-center">
                                            <span>Keep for </span>
                                            <field name="gdrive_retention_days" class="mx-2 oe_inline fw-bold"/>
                                            <span> days</span>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </page>
                    </notebook>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
