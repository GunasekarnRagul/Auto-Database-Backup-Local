<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  List View — Terminal-style log viewer                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_google_drive_sync_log_tree" model="ir.ui.view">
        <field name="name">google.drive.sync.log.tree</field>
        <field name="model">google.drive.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Sync Logs" decoration-danger="state == 'fail'" decoration-success="state == 'success'" create="false" edit="false" default_order="create_date desc">
                <field name="create_date" string="Timestamp" widget="datetime"/>
                <field name="drive_name" string="Drive"/>
                <field name="root_folder_name" string="Root Folder"/>
                <field name="file_name" string="File / Folder"/>
                <field name="file_type" string="Type"/>
                <field name="operation"/>
                <field name="sync_type" string="Trigger"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'fail'"/>
                <field name="error_message" string="Error" optional="show"/>
                <field name="duration" string="Duration (s)" optional="hide"/>
                <field name="user_id" string="User" widget="many2one_avatar" optional="hide"/>
                <field name="google_file_id" string="Drive ID" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Form View — Read-only detail with full error info          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_google_drive_sync_log_form" model="ir.ui.view">
        <field name="name">google.drive.sync.log.form</field>
        <field name="model">google.drive.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log Detail" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,fail"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Operation Details">
                            <field name="operation"/>
                            <field name="sync_type"/>
                            <field name="file_type"/>
                            <field name="file_name"/>
                            <field name="file_size" widget="float" string="Size (bytes)"/>
                            <field name="duration" widget="float" string="Duration (s)"/>
                        </group>
                        <group string="Location">
                            <field name="drive_config_id"/>
                            <field name="drive_name"/>
                            <field name="root_folder_name"/>
                            <field name="folder_path"/>
                            <field name="google_file_id"/>
                        </group>
                    </group>
                    <group string="Metadata">
                        <field name="user_id" widget="many2one_avatar_user"/>
                        <field name="create_date" string="Logged At"/>
                    </group>
                    <group string="Error Details" invisible="state != 'fail'">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Search View — Filters and grouping                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_google_drive_sync_log_search" model="ir.ui.view">
        <field name="name">google.drive.sync.log.search</field>
        <field name="model">google.drive.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">
                <field name="file_name"/>
                <field name="drive_name"/>
                <field name="root_folder_name"/>
                <field name="error_message"/>
                <separator/>
                <filter name="filter_success" string="Success" domain="[('state', '=', 'success')]" icon="fa-check-circle"/>
                <filter name="filter_fail" string="Failed" domain="[('state', '=', 'fail')]" icon="fa-times-circle"/>
                <separator/>
                <filter name="filter_manual" string="Manual Sync" domain="[('sync_type', '=', 'manual')]"/>
                <filter name="filter_auto" string="Auto Sync" domain="[('sync_type', '=', 'auto')]"/>
                <filter name="filter_cron" string="Scheduled" domain="[('sync_type', '=', 'cron')]"/>
                <filter name="filter_upload" string="Upload" domain="[('sync_type', '=', 'upload')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('create_date', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_drive" string="Drive" context="{'group_by': 'drive_config_id'}"/>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_sync_type" string="Sync Type" context="{'group_by': 'sync_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
