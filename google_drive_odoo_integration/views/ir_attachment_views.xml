<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Attachments -->
    <record id="view_attachment_tree_gdrive" model="ir.ui.view">
        <field name="name">Attachments - Tree</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <tree string="Attachments">
                <field name="name" string="File Name"/>
                <field name="model_name" string="Model"/>
                <field name="sync_type" string="Sync Type"/>
                <field name="google_drive_id" string="Drive"/>
                <field name="google_folder_path" string="Folder"/>
                <field name="is_model_enabled_for_sync" string="Model Sync Enabled"/>
                <field name="is_google_synced" string="Synced"/>
                <field name="create_date" string="Created" widget="date"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Attachments -->
    <record id="view_attachment_form_gdrive" model="ir.ui.view">
        <field name="name">Attachments - Form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Attachment">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="File Name"/>
                            <field name="model_name" string="Associated Model"/>
                            <field name="model_display" string="Model Display" readonly="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="mimetype" string="File Type"/>
                            <field name="file_size" string="Size (bytes)"/>
                            <field name="create_date" string="Created"/>
                        </group>
                    </group>




                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Attachments -->
    <record id="view_attachment_search_gdrive" model="ir.ui.view">
        <field name="name">Attachments - Search</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <search string="Attachments">
                <field name="name" string="File Name"/>
                <field name="model_display" string="Model"/>
                <field name="google_drive_id" string="Drive"/>
                <field name="google_folder_id" string="Folder"/>
                
                <separator/>
                <filter name="filter_synced" string="Google Synced" domain="[('is_google_synced', '=', True)]"/>
                <filter name="filter_not_synced" string="Not Synced" domain="[('is_google_synced', '=', False)]"/>

                <separator/>
                <filter name="filter_crm" string="CRM Leads" domain="[('res_model', '=', 'crm.lead')]"/>
                <filter name="filter_sales" string="Sales Orders" domain="[('res_model', '=', 'sale.order')]"/>
                <filter name="filter_accounting" string="Accounting" domain="[('res_model', '=', 'account.move')]"/>
                <filter name="filter_purchase" string="Purchase Orders" domain="[('res_model', '=', 'purchase.order')]"/>
                <filter name="filter_hr" string="HR Employees" domain="[('res_model', '=', 'hr.employee')]"/>
                <filter name="filter_project" string="Project Tasks" domain="[('res_model', '=', 'project.task')]"/>
                <filter name="filter_inventory" string="Inventory" domain="[('res_model', '=', 'stock.picking')]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_model" string="By Model" domain="[]" context="{'group_by':'model_display'}"/>
                    <filter name="group_by_drive" string="By Drive" domain="[]" context="{'group_by':'google_drive_id'}"/>
                    <filter name="group_by_folder" string="By Folder" domain="[]" context="{'group_by':'google_folder_id'}"/>
                    <filter name="group_by_date" string="By Date" domain="[]" context="{'group_by':'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Updated Action for Attachments -->
    <record id="action_google_drive_attachments" model="ir.actions.act_window">
        <field name="name">Attachments</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_attachment_tree_gdrive"/>
        <field name="search_view_id" ref="view_attachment_search_gdrive"/>
        <field name="domain">[]</field>
        <field name="context">{
            'default_google_drive_id': False,
        }</field>
    </record>
</odoo>
