<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Google Drive Model Configuration -->
    <record id="view_gdrive_model_config_tree" model="ir.ui.view">
        <field name="name">Google Drive Model Config - Tree</field>
        <field name="model">gdrive.model.config</field>
        <field name="arch" type="xml">
            <list string="Model Configurations">
                <field name="model_label" string="Model"/>
                <field name="res_model" string="Technical Name"/>
                <field name="drive_root_folder_name" string="Drive Folder"/>
                <field name="is_enabled" string="Enabled"/>
            </list>
        </field>
    </record>

    <!-- Form View for Google Drive Model Configuration -->
    <record id="view_gdrive_model_config_form" model="ir.ui.view">
        <field name="name">Google Drive Model Config - Form</field>
        <field name="model">gdrive.model.config</field>
        <field name="arch" type="xml">
            <form string="Model Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="model_label" string="Model Label"/>
                            <field name="res_model" string="Technical Model Name"/>
                        </group>
                        <group>
                            <field name="drive_root_folder_name" string="Drive Root Folder Name"/>
                            <field name="is_enabled" string="Enabled for Sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Google Drive Model Configuration -->
    <record id="action_gdrive_model_config" model="ir.actions.act_window">
        <field name="name">Model Configurations</field>
        <field name="res_model">gdrive.model.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gdrive_model_config_tree"/>
    </record>
</odoo>