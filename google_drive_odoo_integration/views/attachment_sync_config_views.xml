<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View for Multiple Configurations -->
    <record id="view_attachment_sync_config_kanban" model="ir.ui.view">
        <field name="name">Attachment Sync Configuration - Kanban</field>
        <field name="model">attachment.sync.config</field>
        <field name="arch" type="xml">
            <kanban class="o_cloud_kanban" sample="1" quick_create="false" default_group_by=''>
                <field name="name"/>
                <field name="module_config_id"/>
                <field name="model_name"/>
                <field name="storage_mode"/>
                <field name="google_drive_id"/>
                <field name="sync_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card o_cloud_card">
                            <!-- Left accent stripe -->
                            <div class="o_cloud_card_accent accent-success"/>

                            <!-- Header: Icon + Title + 3-dot menu -->
                            <div class="o_cloud_card_header">
                                <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                                    <div class="o_cloud_card_icon">
                                        <i class="fa fa-cog"/>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="o_cloud_card_title text-truncate">
                                            <field name="name"/>
                                        </div>
                                        <div class="o_cloud_card_subtitle">
                                            <i class="fa fa-gear me-1"/> Sync Configuration
                                        </div>
                                    </div>
                                </div>
                                <!-- 3-dot dropdown menu -->
                                <div class="o_cloud_card_menu o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret" role="button" data-bs-toggle="dropdown" href="#">
                                        <i class="fa fa-ellipsis-v" title="Actions"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">
                                            <i class="fa fa-pencil me-2 text-primary"/>Edit
                                        </a>
                                        <a role="menuitem" type="delete" class="dropdown-item text-danger">
                                            <i class="fa fa-trash-o me-2"/>Delete
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Configuration details tag -->
                            <div style="padding: 6px 16px 0 20px;">
                                <span class="o_cloud_drive_tag" style="white-space: nowrap;">
                                    <i class="fa fa-cube me-1"/><field name="module_config_id"/>
                                </span>
                                <span class="o_cloud_drive_tag ms-1" style="white-space: nowrap; color: #6c757d; border-color: #dee2e6;">
                                    <i class="fa fa-database me-1"/><field name="storage_mode"/>
                                </span>
                            </div>

                            <!-- Details section: Model, Drive, Folder -->
                            <div class="o_cloud_card_details pt-2 border-top mx-3" style="font-size: 11px; color: #666;">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><i class="fa fa-cloud me-1"/> Drive:</span>
                                    <span class="fw-bold text-dark text-truncate"><field name="google_drive_id"/></span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><i class="fa fa-check-circle me-1"/> Synced:</span>
                                    <span class="fw-bold text-dark"><field name="sync_count"/></span>
                                </div>
                            </div>


                            <!-- Footer: Sync Statistics -->
                            <div class="o_cloud_card_footer d-flex justify-content-end">
                                <div class="text-muted" style="font-size: 10px;">
                                    Last Check: <field name="last_synced"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View for List Display -->
    <record id="view_attachment_sync_config_tree" model="ir.ui.view">
        <field name="name">Attachment Sync Configuration - Tree</field>
        <field name="model">attachment.sync.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="module_config_id" string="Module"/>
                <field name="model_name" string="Internal Model" groups="base.group_no_one"/>
                <field name="google_drive_id"/>
                <field name="sync_count"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Creating/Editing Configurations -->
    <record id="view_attachment_sync_wizard_form" model="ir.ui.view">
        <field name="name">Attachment Sync Configuration - Form</field>
        <field name="model">attachment.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-cloud-upload"/> Attachment Sync Configuration
                        </h1>
                        <p class="text-muted">Configure automatic synchronization of attachments from Odoo models to Google Drive</p>
                    </div>

                    <!-- Auto Sync Toggle -->
                    <div class="o_setting_right_pane d-flex align-items-center gap-2 mb-4 p-3 rounded" style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
                        <div class="flex-grow-1">
                            <h5 class="mb-0 fw-bold"><i class="fa fa-refresh me-2 text-primary"/> Auto Sync Mode</h5>
                            <small class="text-muted">When enabled, new attachments will be automatically uploaded to Google Drive.</small>
                        </div>
                        <field name="auto_sync_mode" widget="boolean_toggle" class="ms-auto" style="font-size: 1.2em;"/>
                    </div>

                    <!-- Configuration Name -->
                    <group name="config_name" string="Configuration Details" col="2">
                        <field name="name" placeholder="e.g., CRM Leads to Drive"/>
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i class="fa fa-info-circle me-2"/> Give this configuration a descriptive name to identify it later
                        </div>
                    </group>

                    <!-- Step 1: Module/Model Selection -->
                    <group name="step1" string="Step 1: Select Module" col="2">
                        <field name="existing_module_ids" widget="many2many_tags" invisible="1"/>
                        <field name="module_config_id" options="{'no_create': True, 'no_open': True}" placeholder="Select module..." />
                        <field name="model_name" string="Technical Model" readonly="1" force_save="1" invisible="not module_config_id" />
                        <div colspan="2" class="alert alert-info py-2" role="alert">
                             <i class="fa fa-info-circle me-1"/> Choose the Odoo module for which you want to sync attachments.
                        </div>
                        <!-- Enhanced real-time counter -->
                        <div colspan="2" class="d-flex justify-content-between align-items-center mt-1 mb-3 px-3 py-2 rounded" style="background-color: #f1f7ff; border: 1px solid #d1e3ff; color: #004085;" invisible="not model_name">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-paperclip" style="font-size: 1.1em;"/>
                                <span>Total Odoo attachments found for synchronization:</span>
                            </div>
                            <span class="badge rounded-pill d-inline-flex align-items-center" style="background-color: #004085; color: white; padding: 5px 12px; font-weight: 600; gap: 4px;">
                                <field name="model_attachment_count" class="p-0 m-0"/>
                                <span class="p-0 m-0">Files Found</span>
                            </span>
                        </div>
                    </group>

                    <!-- Step 2: Google Drive Selection -->
                    <group name="step2" string="Step 2: Select Google Drive" col="2">
                        <field name="google_drive_id" widget="selection" required="1" placeholder="Select driver..." />
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i class="fa fa-cloud me-2"/> Select the Google Drive account where files will be stored
                        </div>
                    </group>

                    <!-- Step 3: Folder Selection -->
                    <group name="step3" string="Step 3: Select Folder" col="2">
                        <field name="google_folder_id" widget="selection" required="1" placeholder="Select folder..." />
                        <field name="folder_path" string="Selected Path" readonly="1" class="text-primary font-weight-bold" />
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i class="fa fa-folder-open me-2"/> Choose the destination folder in Google Drive where attachments will be uploaded
                        </div>
                    </group>

                    <!-- Step 4: Storage Mode -->
                    <group name="step4" string="Step 4: Select Storage Mode" col="2">
                        <field name="storage_mode" widget="radio" options="{'horizontal': true}"/>
                        <div colspan="2" class="mt-3 mb-2" style="width:13rem">
                            <button name="action_manual_drive_sync" 
                                    string="Manual Drive Sync Now" 
                                    type="object" 
                                    class="btn btn-primary w-100 py-2 fw-bold" 
                                    icon="fa-cloud-upload"
                                    invisible="storage_mode == 'odoo'"/>
                        </div>
                        <div colspan="2" class="alert alert-light border shadow-sm p-3 mt-2" role="alert" style="border-left: 4px solid #714bca !important;">
                            <div class="d-flex gap-3">
                                <div class="flex-shrink-0">
                                    <i class="fa fa-info-circle text-primary" style="font-size: 1.5rem;"/>
                                </div>
                                <div>
                                    <h6 class="mb-2 fw-bold">Understanding Storage Modes:</h6>
                                    <div class="mb-1"><strong>🚀 Drive only:</strong> Files are stored <strong>only</strong> on Google Drive. Saves server space (Odoo storage minimized).</div>
                                    <div class="mb-1"><strong>🔄 Dual:</strong> Files are kept in <strong>both</strong> Odoo and Google Drive. Maximum redundancy.</div>
                                    <div class="mb-0"><strong>🏠 Odoo only:</strong> Standard local storage. Google Drive synchronization is <strong>disabled</strong>.</div>
                                </div>
                            </div>
                        </div>
                    </group>


                    <!-- ═══════════ Sync Dashboard ═══════════ -->
                    <div class="mt-4" invisible="not model_name">

                        <!-- Dashboard Header -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-bar-chart text-primary" style="font-size: 1.4em;"/>
                                <h4 class="mb-0 fw-bold">Sync Dashboard</h4>
                            </div>
                            <button name="action_view_all_files" type="object" class="btn btn-sm btn-outline-secondary" icon="fa-list">
                                View All Files
                            </button>
                        </div>

                        <!-- Summary Cards Row -->
                        <div class="row g-3 mb-4 px-2">

                            <!-- Total Files Card -->
                            <div class="col-3">
                                <button name="action_view_all_files" type="object" class="btn border rounded-3 p-3 h-100 text-center w-100 d-block shadow-sm" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); transition: all 0.2s;">
                                    <div class="text-muted mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Total Files</div>
                                    <div class="fw-bold" style="font-size: 2rem; color: #495057;">
                                        <field name="model_attachment_count" class="p-0 m-0"/>
                                    </div>
                                    <small class="text-muted"><i class="fa fa-paperclip me-1"/>In Odoo</small>
                                </button>
                            </div>

                            <!-- Synced Card -->
                            <div class="col-3">
                                <button name="action_view_synced_files" type="object" class="btn border rounded-3 p-3 h-100 text-center w-100 d-block shadow-sm" style="background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); border-color: #b1dfbb !important; transition: all 0.2s;">
                                    <div class="mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #155724;">Synced</div>
                                    <div class="fw-bold" style="font-size: 2rem; color: #155724;">
                                        <field name="synced_attachment_count" class="p-0 m-0"/>
                                    </div>
                                    <small style="color: #155724;"><i class="fa fa-check-circle me-1"/>On Drive</small>
                                </button>
                            </div>

                            <!-- Not Synced Card -->
                            <div class="col-3">
                                <button name="action_view_unsynced_files" type="object" class="btn border rounded-3 p-3 h-100 text-center w-100 d-block shadow-sm" style="background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%); border-color: #ffc107 !important; transition: all 0.2s;">
                                    <div class="mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #856404;">Not Synced</div>
                                    <div class="fw-bold" style="font-size: 2rem; color: #856404;">
                                        <field name="unsynced_attachment_count" class="p-0 m-0"/>
                                    </div>
                                    <small style="color: #856404;"><i class="fa fa-clock-o me-1"/>Pending</small>
                                </button>
                            </div>

                            <!-- Last Synced Card -->
                            <div class="col-3">
                                <div class="border rounded-3 p-3 h-100 text-center shadow-sm" style="background: linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%); border-color: #9fa8da !important;">
                                    <div class="mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #283593;">Last Synced</div>
                                    <div class="fw-bold" style="font-size: 1rem; color: #283593; margin-top: 8px;">
                                        <field name="last_synced" class="p-0 m-0"/>
                                    </div>
                                    <small style="color: #283593;"><i class="fa fa-history me-1"/>
                                        <field name="storage_mode" class="p-0 m-0"/> mode
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="col-12 w-100 mt-2 mb-4 px-2">
                            <style>
                                .o_custom_sync_progress {
                                    width: 100% !important;
                                }
                                .o_custom_sync_progress .o_field_progressbar,
                                .o_custom_sync_progress .o_progressbar {
                                    width: 100% !important;
                                }
                                /* Make the bar green and thicker */
                                .o_custom_sync_progress .o_progress {
                                    height: 16px !important;
                                    background-color: #e9ecef !important;
                                    border: 1px solid #dee2e6 !important;
                                    border-radius: 8px !important;
                                    overflow: hidden !important;
                                    margin-right:30px;
                                    flex-grow: 1; /* allow it to take width */
                                }
                                .o_custom_sync_progress .o_progressbar_value {
                                    
                                    border-radius: 8px !important;
                                }
                                /* Fix text color to be visible properly */
                                .o_custom_sync_progress .o_progressbar_value_text,
                                .o_custom_sync_progress .o_progressbar_title {
                                    color: #495057 !important;
                                    font-weight: bold !important;
                                    background: none !important;
                                    border-radius: 0 !important;
                                    margin-left: 10px;
                                }
                            </style>
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.8px;">Overall Integration Progress</h6>
                            <div class="o_custom_sync_progress w-100">
                                <field name="sync_percentage" widget="progressbar" nolabel="1"/>
                            </div>
                        </div>

                    </div>


                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save_and_return" class="btn btn-primary"/>
                    <button string="Manual Drive Sync" type="object" name="action_manual_drive_sync" class="btn btn-secondary" invisible="storage_mode == 'odoo'"/>
                    <button string="Discard" class="btn btn-light" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Search View for Filtering -->
    <record id="view_attachment_sync_config_search" model="ir.ui.view">
        <field name="name">Attachment Sync Configuration - Search</field>
        <field name="model">attachment.sync.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <field name="google_drive_id"/>
                <separator/>
                <filter name="filter_auto_sync" string="Auto Sync" domain="[('auto_sync_mode', '=', True)]"/>
                <filter name="filter_manual" string="Manual" domain="[('auto_sync_mode', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action for Attachment Sync Configuration -->
    <record id="action_attachment_sync_config" model="ir.actions.act_window">
        <field name="name">Attachment Sync Configuration</field>
        <field name="res_model">attachment.sync.config</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_attachment_sync_config_search"/>
        <field name="context">{'default_state': 'active', 'group_by': ''}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Attachment Sync Configuration!
            </p>
            <p>
                Set up rules to automatically or manually synchronize attachments from Odoo to Google Drive.
            </p>
        </field>
    </record>
</odoo>