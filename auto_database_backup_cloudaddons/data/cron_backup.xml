<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Scheduled Action: Auto Database Backup ──────────────────────────── -->
    <record id="ir_cron_auto_database_backup" model="ir.cron">
        <field name="name">Auto Database Backup: Run All Configurations</field>
        <field name="model_id" ref="auto_database_backup_cloudaddons.model_auto_backup_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_run_all_backups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
