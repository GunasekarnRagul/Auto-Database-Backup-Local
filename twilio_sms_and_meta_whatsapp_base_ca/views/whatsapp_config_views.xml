<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_config_form" model="ir.ui.view">
        <field name="name">whatsapp.config.form</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">

<form string="WhatsApp Account" class="oe_form">

<header>
    <button name="action_test_connection"
            string="Connect Account"
            type="object"
            class="btn-primary"
            icon="fa-bolt"
            invisible="connection_status == 'connected'"/>

    <field name="connection_status" widget="statusbar" statusbar_visible="unknown,connected,failed"/>
</header>

<sheet>

    <!-- RIBBONS -->
    <widget name="web_ribbon" title="Connected" bg_color="bg-success"
            invisible="connection_status != 'connected'"/>
    <widget name="web_ribbon" title="Not Connected" bg_color="bg-secondary"
            invisible="connection_status == 'connected'"/>

    <!-- ==================== SETUP MODE ==================== -->
    <div invisible="connection_status == 'connected'">

        <!-- Hero Banner -->
        <div class="p-4 rounded-3 mb-4 mt-2"
             style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); color: white;">
            <div class="row align-items-center">
                <div class="col-8">
                    <h2 class="m-0 fw-bold text-white">
                        <i class="fa fa-whatsapp me-2"/> Connect WhatsApp
                    </h2>
                    <p class="m-0 mt-1 opacity-75" style="font-size: 14px;">
                        Link your Meta WhatsApp Business API account to start sending messages.
                    </p>
                </div>
                <div class="col-4 text-end">
                    <i class="fa fa-whatsapp opacity-25" style="font-size: 50px;"/>
                </div>
            </div>
        </div>

        <!-- Credentials Card -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Provider Selection -->
                <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
                    <div class="card-body p-4 text-center">
                        <group>
                            <field name="provider" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </div>
                </div>

                <!-- API Credentials -->
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <group string="Meta API Credentials" invisible="provider != 'meta'">
                            <field name="name" placeholder="e.g. My WhatsApp Business"/>
                            <field name="phone_number_id" placeholder="Enter Phone Number ID" required="1"/>
                            <field name="whatsapp_business_account_id"
                                   placeholder="Enter WABA ID (from Meta URL)"
                                   required="provider == 'meta'"/>
                            <field name="access_token" password="True"
                                   placeholder="Enter Access Token" required="1"/>
                            <field name="api_version" placeholder="v18.0"/>
                        </group>
                    </div>
                </div>

                <div class="alert border-0 mt-3 shadow-sm"
                     style="border-radius: 10px; background: #E8F5E9; border-left: 4px solid #25D366 !important;"
                     invisible="provider != 'meta'">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-lightbulb-o fa-lg me-3" style="color: #25D366;"/>
                        <div>
                            <strong>Where to find your credentials?</strong>
                            <br/>
                            <small class="text-muted">
                                Go to
                                <a href="https://developers.facebook.com" target="_blank"
                                   class="fw-bold text-decoration-none" style="color: #128C7E;">
                                    Meta for Developers
                                </a>
                                → WhatsApp → API Setup to get your Phone Number ID and Access Token.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ==================== CONNECTED DASHBOARD ==================== -->
    <div invisible="connection_status != 'connected'">

        <div class="card border-0 shadow mt-2" style="border-radius: 16px; overflow: hidden;">

            <!-- Header -->
            <div class="p-4"
                 style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); color: white;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 50px; height: 50px; background: rgba(255,255,255,0.2);">
                            <i class="fa fa-whatsapp" style="font-size: 24px;"/>
                        </div>
                        <div>
                            <h3 class="m-0 fw-bold text-white">WhatsApp Business Active</h3>
                            <small class="opacity-75">
                                <i class="fa fa-check-circle me-1"/> Connected via
                                <field name="provider" readonly="1" nolabel="1" style="font-weight: bold;"/>
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="bg-white px-4 py-3">
                <div class="row g-3">
                    <!-- Quality Rating -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 text-center"
                             style="background: linear-gradient(135deg, #E8F5E9, #C8E6C9); border: 1px solid #A5D6A7;">
                            <div class="text-uppercase fw-bold mb-1"
                                 style="font-size: 10px; letter-spacing: 1px; color: #2E7D32;">
                                Quality Rating
                            </div>
                            <div class="fw-bold" style="font-size: 22px; color: #1B5E20;">
                                <field name="quality_rating" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <!-- Messaging Limit -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 text-center"
                             style="background: linear-gradient(135deg, #E3F2FD, #BBDEFB); border: 1px solid #90CAF9;">
                            <div class="text-uppercase fw-bold mb-1"
                                 style="font-size: 10px; letter-spacing: 1px; color: #1565C0;">
                                Messaging Limit
                            </div>
                            <div class="fw-bold" style="font-size: 22px; color: #0D47A1;">
                                <field name="messaging_limit" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <!-- Account Mode -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 text-center"
                             style="background: linear-gradient(135deg, #FFF3E0, #FFE0B2); border: 1px solid #FFCC80;">
                            <div class="text-uppercase fw-bold mb-1"
                                 style="font-size: 10px; letter-spacing: 1px; color: #E65100;">
                                Account Mode
                            </div>
                            <div class="fw-bold" style="font-size: 22px; color: #BF360C;">
                                <field name="account_mode" readonly="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="m-0" style="opacity: 0.08;"/>

            <!-- Details Section -->
            <div class="bg-white p-4">
                <div class="row g-4">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <h6 class="text-uppercase fw-bold mb-3"
                            style="font-size: 11px; letter-spacing: 1px; color: #25D366;">
                            <i class="fa fa-user-circle me-1"/> Account Details
                        </h6>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-check-circle" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">VERIFIED NAME</small>
                                <span class="fw-semibold"><field name="verified_name" readonly="1"/></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-phone" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">PHONE NUMBER</small>
                                <span class="fw-bold" style="color: #128C7E; font-size: 16px;">
                                    <field name="display_phone_number" readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-signal" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">ACCOUNT STATUS</small>
                                <span class="fw-semibold"><field name="account_status" readonly="1"/></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-building" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">OFFICIAL BUSINESS</small>
                                <span class="fw-semibold"><field name="is_official_business" readonly="1"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <h6 class="text-uppercase fw-bold mb-3"
                            style="font-size: 11px; letter-spacing: 1px; color: #25D366;">
                            <i class="fa fa-cog me-1"/> API Configuration
                        </h6>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-hashtag" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">PHONE NUMBER ID</small>
                                <span class="font-monospace text-muted" style="font-size: 12px;">
                                    <field name="phone_number_id" readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-key" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">WABA ID</small>
                                <span class="font-monospace text-muted" style="font-size: 12px;">
                                    <field name="whatsapp_business_account_id" readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-clock-o" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">LAST VERIFIED</small>
                                <span class="fw-semibold"><field name="last_tested" readonly="1"/></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center p-2 rounded"
                             style="background: #F1F8F4;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 36px; height: 36px; background: #E8F5E9;">
                                <i class="fa fa-tag" style="color: #25D366; font-size: 14px;"/>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">ACCOUNT LABEL</small>
                                <span class="fw-semibold"><field name="name" readonly="1"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-white px-4 py-3 border-top d-flex justify-content-end">
                <button name="action_disconnect" string="Disconnect &amp; Reset"
                        type="object"
                        class="btn btn-outline-danger btn-sm rounded-pill px-4"
                        icon="fa-power-off"/>
            </div>

        </div>
    </div>

</sheet>
</form>

        </field>
    </record>

    <!-- Tree View -->
    <record id="view_whatsapp_config_tree" model="ir.ui.view">
        <field name="name">whatsapp.config.tree</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts"
                  decoration-success="connection_status == 'connected'"
                  decoration-muted="connection_status == 'unknown'">
                <field name="name"/>
                <field name="verified_name"/>
                <field name="display_phone_number"/>
                <field name="quality_rating"/>
                <field name="connection_status" widget="badge"
                       decoration-success="connection_status == 'connected'"
                       decoration-danger="connection_status == 'failed'"
                       decoration-info="connection_status == 'unknown'"/>
            </list>
        </field>
    </record>

    <!-- Action to open settings -->
    <record id="action_whatsapp_config" model="ir.actions.act_window">
        <field name="name">WhatsApp Settings</field>
        <field name="res_model">whatsapp.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your WhatsApp API connections
            </p>
        </field>
    </record>

    <!-- Server action for menu -->
    <record id="action_whatsapp_open_settings" model="ir.actions.server">
        <field name="name">WhatsApp Settings</field>
        <field name="model_id" ref="model_whatsapp_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_settings()</field>
    </record>
</odoo>
