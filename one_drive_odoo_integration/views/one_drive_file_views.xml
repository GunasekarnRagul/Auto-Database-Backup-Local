<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="one_drive_file_view_tree" model="ir.ui.view">
        <field name="name">one.drive.file.view.tree</field>
        <field name="model">one.drive.file</field>
        <field name="arch" type="xml">
            <list decoration-info="file_type == 'folder'" default_order="file_type desc, name asc">
                <field name="name"/>
                <field name="file_type" widget="badge"
                       decoration-info="file_type == 'folder'"
                       decoration-success="file_type == 'file'"/>
                <field name="drive_config_id"/>
                <field name="owner_name"/>
                <field name="last_modified"/>
                <field name="mime_type" optional="hide"/>
                <field name="file_size" string="Size (KB)"/>
                <field name="sync_state" widget="badge"
                       decoration-success="sync_state == 'synced'"
                       decoration-warning="sync_state == 'pending'"
                       decoration-info="sync_state == 'uploading'"
                       decoration-danger="sync_state == 'error'"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <record id="one_drive_file_view_kanban" model="ir.ui.view">
        <field name="name">one.drive.file.view.kanban</field>
        <field name="model">one.drive.file</field>
        <field name="arch" type="xml">
            <kanban class="o_file_explorer" quick_create="false" default_order="file_type desc, name asc">
                <field name="name"/>
                <field name="file_type"/>
                <field name="mime_type"/>
                <field name="file_size"/>
                <field name="sync_state"/>
                <field name="upload_progress"/>
                <field name="drive_config_id"/>
                <field name="one_drive_url"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- FOLDER card -->
                        <div t-if="record.file_type.raw_value == 'folder'"
                             class="oe_kanban_global_click o_file_card is-folder">
                            <div class="o_folder_icon">
                                <img src="/one_drive_odoo_integration/static/src/img/folder_icon.svg" alt="Folder"/>
                            </div>
                            <span class="o_file_name"><field name="name"/></span>
                            <!-- 3-dot menu -->
                            <div class="o_file_card_menu o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret" role="button" data-bs-toggle="dropdown" href="#">
                                    <i class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end" role="menu">
                                    <a role="menuitem" type="open" class="dropdown-item">
                                        <i class="fa fa-folder-open me-2"/>Open
                                    </a>
                                    <a role="menuitem" type="edit" class="dropdown-item">
                                        <i class="fa fa-pencil me-2"/>Rename
                                    </a>
                                    <div class="dropdown-divider"/>
                                    <a role="menuitem" type="object" name="action_prompt_delete" class="dropdown-item text-danger">
                                        <i class="fa fa-trash-o me-2"/>Remove
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- FILE card -->
                        <div t-if="record.file_type.raw_value == 'file'"
                             class="oe_kanban_global_click o_file_card is-file">
                            <!-- Preview area -->
                            <div class="o_file_preview">
                                <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('spreadsheet') != -1"
                                   class="fa fa-table o_file_type_icon text-sheets"/>
                                <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('document') != -1"
                                   class="fa fa-file-text-o o_file_type_icon text-docs"/>
                                <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('presentation') != -1"
                                   class="fa fa-desktop o_file_type_icon text-slides"/>
                                <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('pdf') != -1"
                                   class="fa fa-file-pdf-o o_file_type_icon text-pdf"/>
                                <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('image') != -1"
                                   class="fa fa-file-image-o o_file_type_icon text-image"/>
                                <i t-if="!record.mime_type.raw_value"
                                   class="fa fa-file-o o_file_type_icon text-default"/>
                            </div>
                            <!-- File info bar -->
                            <div class="o_file_info">
                                <div class="o_file_icon_small">
                                    <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('spreadsheet') != -1"
                                       class="fa fa-table text-sheets"/>
                                    <i t-if="record.mime_type.raw_value and record.mime_type.raw_value.indexOf('document') != -1"
                                       class="fa fa-file-text-o text-docs"/>
                                    <i t-if="!record.mime_type.raw_value"
                                       class="fa fa-file-o" style="color: #5f6368;"/>
                                </div>
                                <span class="o_file_name"><field name="name"/></span>
                                <!-- 3-dot menu -->
                                <div class="o_file_card_menu o_dropdown_kanban dropdown" style="position:static; opacity:0;">
                                    <a class="dropdown-toggle o-no-caret" role="button" data-bs-toggle="dropdown" href="#">
                                        <i class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">
                                            <i class="fa fa-pencil me-2"/>Edit
                                        </a>
                                        <a role="menuitem" type="object" name="action_prompt_delete" class="dropdown-item text-danger">
                                            <i class="fa fa-trash-o me-2"/>Remove
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="one_drive_file_view_form" model="ir.ui.view">
        <field name="name">one.drive.file.view.form</field>
        <field name="model">one.drive.file</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_in_drive" string="Open in OneDrive"
                            type="object" class="btn-primary" icon="fa-external-link"
                            invisible="not one_drive_url"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Project Documents"/>
                        </h1>
                    </div>
                    <group>
                        <group string="File Details">
                            <field name="file_type"/>
                            <field name="mime_type"/>
                            <field name="file_size"/>
                            <field name="owner_name"/>
                            <field name="last_modified"/>
                            <field name="starred"/>
                            <field name="drive_config_id"/>
                            <field name="parent_folder_id"/>
                        </group>
                        <group string="OneDrive">
                            <field name="one_drive_file_id"/>
                            <field name="one_drive_url" widget="url"/>
                            <field name="sync_state" widget="badge"
                                   decoration-success="sync_state == 'synced'"
                                   decoration-warning="sync_state == 'pending'"
                                   decoration-danger="sync_state == 'error'"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                    <notebook invisible="file_type != 'folder'">
                        <page string="Contents">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="file_type" widget="badge"/>
                                    <field name="file_size"/>
                                    <field name="sync_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="one_drive_file_view_search" model="ir.ui.view">
        <field name="name">one.drive.file.view.search</field>
        <field name="model">one.drive.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="drive_config_id"/>
                <field name="file_type"/>
                <separator/>
                <filter string="Files" name="files" domain="[('file_type', '=', 'file')]"/>
                <filter string="Folders" name="folders" domain="[('file_type', '=', 'folder')]"/>
                <separator/>
                <filter string="Synced" name="synced" domain="[('sync_state', '=', 'synced')]"/>
                <filter string="Pending" name="pending" domain="[('sync_state', '=', 'pending')]"/>
                <filter string="Uploading" name="uploading" domain="[('sync_state', '=', 'uploading')]"/>
                <filter string="Error" name="error" domain="[('sync_state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Drive" name="group_drive" context="{'group_by': 'drive_config_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'file_type'}"/>
                    <filter string="Sync Status" name="group_sync" context="{'group_by': 'sync_state'}"/>
                    <filter string="Parent Folder" name="group_parent" context="{'group_by': 'parent_folder_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="one_drive_file_action" model="ir.actions.act_window">
        <field name="name">File Explorer</field>
        <field name="res_model">one.drive.file</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="one_drive_file_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No files synced yet!
            </p>
            <p>
                Files from your connected OneDrives will appear here once synced.
            </p>
        </field>
    </record>
</odoo>
