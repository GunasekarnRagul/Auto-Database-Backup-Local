<odoo>
    <record id="view_one_drive_folder_wizard_form" model="ir.ui.view">
        <field name="name">one.drive.folder.wizard.view.form</field>
        <field name="model">one.drive.folder.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Add Folders">
                <header>
                    <button name="action_fetch_folders" string="Fetch Top Folders" type="object" class="btn-primary" icon="fa-download"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                         You can either <strong>Paste Folder IDs</strong> directly in the text area below, or click <strong>Fetch Top Folders</strong> to list available folders from your Drive.
                    </div>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="folder_ids_raw" placeholder="1abc...&#10;1xyz..."/>
                    </group>
                    <notebook invisible="not line_ids">
                        <page string="Select Folders">
                            <field name="line_ids">
                                <tree editable="bottom" create="0">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="name" readonly="1"/>
                                    <field name="google_id" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply" string="Add Folders" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_one_drive_folder_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Add Folders</field>
        <field name="res_model">one.drive.folder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
