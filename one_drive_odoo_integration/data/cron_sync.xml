<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_one_drive_sync" model="ir.cron">
        <field name="name">OneDrive: Backward Sync</field>
        <field name="model_id" search="[('model', '=', 'one.drive.sync')]" model="ir.model"/>
        <field name="state">code</field>
        <field name="code">model.with_context(sync_type='cron').fetch_and_sync_files()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
